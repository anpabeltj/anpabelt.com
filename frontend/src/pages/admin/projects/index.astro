---
declare const Astro: any;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { listProjects } from "../../../lib/projects";
import { formatDate } from "../../../lib/markdown";

const filter = (Astro.url.searchParams.get("status") ?? "all") as "all" | "published" | "draft";
const all = await listProjects({ status: "all" });
const projects = filter === "all" ? all : all.filter((p) => p.status === filter);
const counts = {
  all: all.length,
  published: all.filter((p) => p.status === "published").length,
  draft: all.filter((p) => p.status === "draft").length,
};
const canReorder = filter === "all" && projects.length > 1;
const tab = (key: "all" | "published" | "draft", label: string) =>
  `<a href="/admin/projects?status=${key}" data-testid="project-tab-${key}" class="px-3 py-1.5 rounded-lg text-sm transition-colors ${filter === key ? "bg-teal-500/15 text-teal-300" : "text-retro-50/70 hover:bg-white/5"}">${label} <span class="text-retro-400">${counts[key]}</span></a>`;
---

<AdminLayout title="Projects" active="projects">
  <div class="flex items-center justify-between gap-4 mb-6">
    <h1 class="font-display text-2xl font-bold">Projects</h1>
    <a href="/admin/projects/new" data-testid="new-project-button" class="rounded-lg bg-teal-500 hover:bg-teal-400 text-canvas font-semibold px-4 py-2 text-sm transition-colors">+ New Project</a>
  </div>

  <div class="flex items-center justify-between gap-3 mb-6 flex-wrap">
    <div class="flex items-center gap-1" set:html={tab("all", "All") + tab("published", "Published") + tab("draft", "Drafts")}></div>
    {projects.length > 1 && (
      <p class="text-xs font-mono text-retro-400" data-testid="reorder-hint">
        {canReorder ? "Drag rows to reorder how they appear on your site." : "Switch to All to reorder projects."}
      </p>
    )}
  </div>

  {projects.length === 0 ? (
    <div class="rounded-2xl border border-white/10 bg-card p-12 text-center">
      <p class="text-retro-400">No projects here yet.</p>
      <a href="/admin/projects/new" class="mt-4 inline-flex text-teal-300 hover:text-teal-200">Add your first project →</a>
    </div>
  ) : (
    <div class="rounded-2xl border border-white/10 bg-card overflow-hidden" data-testid="admin-project-list" data-reorder={canReorder ? "1" : "0"}>
      {projects.map((project) => (
        <div class="admin-project-row flex items-center gap-4 px-4 sm:px-6 py-4 border-b border-white/5 last:border-0 hover:bg-white/[0.02] transition-opacity" data-testid="admin-project-row" data-id={project.id} draggable={canReorder}>
          {canReorder && (
            <span class="drag-handle shrink-0 cursor-grab text-retro-400 hover:text-teal-300 transition-colors" title="Drag to reorder" data-testid="project-drag-handle">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="9" cy="6" r="1.6"/><circle cx="15" cy="6" r="1.6"/><circle cx="9" cy="12" r="1.6"/><circle cx="15" cy="12" r="1.6"/><circle cx="9" cy="18" r="1.6"/><circle cx="15" cy="18" r="1.6"/></svg>
            </span>
          )}
          <div class="w-14 h-14 shrink-0 rounded-lg overflow-hidden bg-elevated border border-white/10">
            {project.image && <img src={project.image} alt={project.title} class="w-full h-full object-cover" loading="lazy" />}
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class={`inline-block w-2 h-2 rounded-full ${project.status === "published" ? "bg-emerald-400" : "bg-amber-400"}`}></span>
              <a href={`/admin/projects/${project.id}/edit`} class="font-medium text-white hover:text-teal-300 truncate" data-testid="admin-project-edit-link">{project.title}</a>
            </div>
            <p class="mt-1 text-xs font-mono text-retro-400 truncate">
              {project.status === "published" ? "Published" : "Draft"} · updated {formatDate(project.updatedAt)}
              {project.techStacks.length > 0 && ` · ${project.techStacks.join(", ")}`}
            </p>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            {project.liveUrl && (
              <a href={project.liveUrl} target="_blank" class="text-xs text-retro-50/60 hover:text-white px-2 py-1">Live ↗</a>
            )}
            <a href={`/admin/projects/${project.id}/edit`} class="text-xs rounded-md border border-white/10 px-3 py-1.5 hover:border-teal-500/40 hover:text-teal-300 transition-colors">Edit</a>
            <button data-id={project.id} data-title={project.title} class="admin-project-delete-btn text-xs rounded-md border border-white/10 px-3 py-1.5 hover:border-red-500/40 hover:text-red-300 transition-colors" data-testid="admin-project-delete-button">Delete</button>
          </div>
        </div>
      ))}
    </div>
  )}
  <p id="reorder-msg" class="mt-3 text-xs text-teal-300 hidden" role="status" data-testid="reorder-status"></p>
</AdminLayout>

<script>
  // ---- Delete ----
  document.querySelectorAll(".admin-project-delete-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const el = btn as HTMLButtonElement;
      const id = el.dataset.id;
      if (!id || !confirm(`Delete "${el.dataset.title}"? This cannot be undone.`)) return;
      el.disabled = true;
      const res = await fetch(`/actions/projects/${id}`, { method: "DELETE" });
      if (res.ok) window.location.reload();
      else { alert("Failed to delete project."); el.disabled = false; }
    });
  });

  // ---- Drag reorder ----
  const list = document.querySelector('[data-testid="admin-project-list"]') as HTMLElement | null;
  const msg = document.getElementById("reorder-msg");
  if (list && list.dataset.reorder === "1") {
    let dragEl: HTMLElement | null = null;

    function rows(): HTMLElement[] {
      return Array.from(list!.querySelectorAll<HTMLElement>('[data-testid="admin-project-row"]'));
    }
    function afterElement(y: number): HTMLElement | null {
      const els = rows().filter((r) => r !== dragEl);
      let closest: { offset: number; el: HTMLElement | null } = { offset: Number.NEGATIVE_INFINITY, el: null };
      for (const child of els) {
        const box = child.getBoundingClientRect();
        const offset = y - box.top - box.height / 2;
        if (offset < 0 && offset > closest.offset) closest = { offset, el: child };
      }
      return closest.el;
    }

    rows().forEach((row) => {
      row.addEventListener("dragstart", () => {
        dragEl = row;
        setTimeout(() => row.classList.add("opacity-40"), 0);
      });
      row.addEventListener("dragend", async () => {
        row.classList.remove("opacity-40");
        dragEl = null;
        const ids = rows().map((r) => r.dataset.id);
        try {
          const res = await fetch("/actions/projects/reorder", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ids }),
          });
          if (!res.ok) throw new Error();
          if (msg) { msg.textContent = "Order saved ✓"; msg.classList.remove("hidden"); setTimeout(() => msg.classList.add("hidden"), 1800); }
        } catch {
          if (msg) { msg.textContent = "Failed to save order."; msg.className = "mt-3 text-xs text-red-400"; msg.classList.remove("hidden"); }
        }
      });
    });

    list.addEventListener("dragover", (e) => {
      e.preventDefault();
      if (!dragEl) return;
      const after = afterElement((e as DragEvent).clientY);
      if (after == null) list!.appendChild(dragEl);
      else list!.insertBefore(dragEl, after);
    });
  }
</script>
