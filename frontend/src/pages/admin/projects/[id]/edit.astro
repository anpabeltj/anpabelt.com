---
declare const Astro: any;
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import ProjectEditor from "../../../../components/ProjectEditor.astro";
import { getProjectById } from "../../../../lib/projects";

const project = await getProjectById(Astro.params.id!);
if (!project) return Astro.redirect("/admin/projects");
---

<AdminLayout title="Edit Project" active="projects">
  <div class="flex items-center gap-3 mb-6">
    <a href="/admin/projects" class="text-sm text-retro-50/70 hover:text-white">← Projects</a>
    <h1 class="font-display text-xl font-bold">Edit Project</h1>
  </div>
  <ProjectEditor project={project} />
</AdminLayout>
