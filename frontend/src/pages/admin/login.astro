---
import AdminLayout from "../../layouts/AdminLayout.astro";
// If already logged in, go straight to the dashboard.
if (Astro.locals.user) return Astro.redirect("/admin");
---

<AdminLayout title="Sign in">
  <div class="min-h-[70vh] flex items-center justify-center">
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <a href="/" class="font-display font-bold text-2xl">anpabelt<span class="text-teal-400">.com</span></a>
        <p class="mt-2 text-sm text-retro-400 font-mono">Admin access only</p>
      </div>

      <form id="login-form" class="rounded-2xl border border-white/10 bg-card p-7 space-y-5" data-testid="login-form">
        <div>
          <label for="email" class="block text-sm font-medium text-white mb-2">Email</label>
          <input id="email" name="email" type="email" required autocomplete="username" data-testid="login-email-input"
            class="w-full rounded-lg bg-elevated border border-white/10 px-4 py-3 text-retro-50 focus:outline-none focus:ring-2 focus:ring-teal-400/70 transition" />
        </div>
        <div>
          <label for="password" class="block text-sm font-medium text-white mb-2">Password</label>
          <input id="password" name="password" type="password" required autocomplete="current-password" data-testid="login-password-input"
            class="w-full rounded-lg bg-elevated border border-white/10 px-4 py-3 text-retro-50 focus:outline-none focus:ring-2 focus:ring-teal-400/70 transition" />
        </div>
        <button type="submit" data-testid="login-submit-button"
          class="w-full rounded-lg bg-teal-500 hover:bg-teal-400 text-canvas font-semibold py-3 transition-colors disabled:opacity-60">
          Sign in
        </button>
        <p id="login-error" class="text-sm text-red-400 text-center hidden" data-testid="login-error" role="alert"></p>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById("login-form") as HTMLFormElement;
  const errEl = document.getElementById("login-error") as HTMLElement;
  const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errEl.classList.add("hidden");
    btn.disabled = true;
    btn.textContent = "Signing in…";
    const data = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch("/actions/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || "Login failed.");
      window.location.href = "/admin";
    } catch (err) {
      errEl.textContent = err instanceof Error ? err.message : "Login failed.";
      errEl.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = "Sign in";
    }
  });
</script>
