---
declare const Astro: any;
import AdminLayout from "../../layouts/AdminLayout.astro";
// If already logged in, go straight to the dashboard.
if (Astro.locals.user) return Astro.redirect("/admin");
---

<AdminLayout title="Sign in">
  <div class="min-h-[70vh] flex items-center justify-center">
    <div class="w-full max-w-sm">
      <div class="text-left mb-10">
        <a href="/" class="font-display font-normal lowercase text-2xl tracking-[0.28em]">anpabelt<span class="text-mono-400">.com</span></a>
        <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.22em] text-mono-400">// admin access only</p>
      </div>

      <form id="login-form" class="border-t border-white/10 pt-8 space-y-6" data-testid="login-form">
        <div>
          <label for="email" class="mlabel block mb-3">Email</label>
          <input id="email" name="email" type="email" required autocomplete="username" data-testid="login-email-input"
            class="w-full rounded-none bg-transparent border-b border-white/15 px-0 py-3 text-retro-50 placeholder:text-retro-400/60 focus:outline-none focus:border-white transition" />
        </div>
        <div>
          <label for="password" class="mlabel block mb-3">Password</label>
          <input id="password" name="password" type="password" required autocomplete="current-password" data-testid="login-password-input"
            class="w-full rounded-none bg-transparent border-b border-white/15 px-0 py-3 text-retro-50 placeholder:text-retro-400/60 focus:outline-none focus:border-white transition" />
        </div>
        <button type="submit" data-testid="login-submit-button"
          class="w-full rounded-none border border-white/30 px-6 py-3 text-sm font-mono uppercase tracking-[0.18em] text-white hover:bg-white hover:text-black transition-colors disabled:opacity-50">
          Sign in
        </button>
        <p id="login-error" class="text-sm font-mono text-red-400 text-center hidden" data-testid="login-error" role="alert"></p>
      </form>
    </div>
  </div>
</AdminLayout>