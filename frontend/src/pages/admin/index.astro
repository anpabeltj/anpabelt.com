---
declare const Astro: any;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { listPosts } from "../../lib/posts";
import { formatDate } from "../../lib/markdown";

const filter = (Astro.url.searchParams.get("status") ?? "all") as "all" | "published" | "draft";
const all = await listPosts({ status: "all" });
const posts = filter === "all" ? all : all.filter((p) => p.status === filter);
const counts = {
  all: all.length,
  published: all.filter((p) => p.status === "published").length,
  draft: all.filter((p) => p.status === "draft").length,
};
const tab = (key: "all" | "published" | "draft", label: string) =>
  `<a href="/admin?status=${key}" data-testid="tab-${key}" class="px-3 py-1.5 rounded-lg text-sm transition-colors ${filter === key ? "bg-white/15 text-white" : "text-retro-50/70 hover:bg-white/5"}">${label} <span class="text-retro-400">${counts[key]}</span></a>`;
---

<AdminLayout title="Posts" active="posts">
  <div class="flex items-center justify-between gap-4 mb-6">
    <h1 class="font-display text-2xl font-bold">Posts</h1>
    <a href="/admin/posts/new" data-testid="new-post-button" class="rounded-lg bg-white hover:bg-retro-100 text-black font-semibold px-4 py-2 text-sm transition-colors">+ New Post</a>
  </div>

  <div class="flex items-center gap-1 mb-6" set:html={tab("all", "All") + tab("published", "Published") + tab("draft", "Drafts")}></div>

  {posts.length === 0 ? (
    <div class="rounded-2xl border border-white/10 bg-card p-12 text-center">
      <p class="text-retro-400">No posts here yet.</p>
      <a href="/admin/posts/new" class="mt-4 inline-flex text-white hover:text-white">Write your first post →</a>
    </div>
  ) : (
    <div class="rounded-2xl border border-white/10 bg-card overflow-hidden" data-testid="admin-post-list">
      {posts.map((post) => (
        <div class="flex items-center gap-4 px-4 sm:px-6 py-4 border-b border-white/5 last:border-0 hover:bg-white/[0.02]" data-testid="admin-post-row">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class={`inline-block w-2 h-2 rounded-full ${post.status === "published" ? "bg-white" : "bg-amber-400"}`}></span>
              <a href={`/admin/posts/${post.id}/edit`} class="font-medium text-white hover:text-white truncate" data-testid="admin-post-edit-link">{post.title}</a>
            </div>
            <p class="mt-1 text-xs font-mono text-retro-400">
              {post.status === "published" ? `Published ${formatDate(post.publishedAt)}` : `Draft · updated ${formatDate(post.updatedAt)}`}
              {post.tags.length > 0 && ` · ${post.tags.map((t) => "#" + t).join(" ")}`}
            </p>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            {post.status === "published" && (
              <a href={`/blog/${post.slug}`} target="_blank" class="text-xs text-retro-50/60 hover:text-white px-2 py-1">View ↗</a>
            )}
            <a href={`/admin/posts/${post.id}/edit`} class="text-xs rounded-md border border-white/10 px-3 py-1.5 hover:border-white/40 hover:text-white transition-colors">Edit</a>
            <button data-id={post.id} data-title={post.title} class="admin-delete-btn text-xs rounded-md border border-white/10 px-3 py-1.5 hover:border-red-500/40 hover:text-red-300 transition-colors" data-testid="admin-post-delete-button">Delete</button>
          </div>
        </div>
      ))}
    </div>
  )}
</AdminLayout>

<script>
  document.querySelectorAll(".admin-delete-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const el = btn as HTMLButtonElement;
      const id = el.dataset.id;
      if (!id || !confirm(`Delete "${el.dataset.title}"? This cannot be undone.`)) return;
      el.disabled = true;
      const res = await fetch(`/actions/posts/${id}`, { method: "DELETE" });
      if (res.ok) window.location.reload();
      else { alert("Failed to delete post."); el.disabled = false; }
    });
  });
</script>
