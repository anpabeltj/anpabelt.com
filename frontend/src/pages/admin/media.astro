---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { listMedia } from "../../lib/media";
import { listPosts } from "../../lib/posts";
import { formatDate } from "../../lib/markdown";

const media = await listMedia();
const posts = await listPosts({ status: "all" });

// Which posts reference a given image URL (cover, inline content, or gallery item).
function usageFor(url: string) {
  return posts
    .filter(
      (p) =>
        p.coverImage === url ||
        (p.content && p.content.includes(url)) ||
        (p.images && p.images.some((i) => i.url === url))
    )
    .map((p) => ({ id: p.id, title: p.title, status: p.status }));
}

const items = media.map((m) => ({ m, usage: usageFor(m.url) }));
---

<AdminLayout title="Media" active="media">
  <div class="flex items-center justify-between gap-4 mb-6">
    <h1 class="font-display text-2xl font-bold">Media Library</h1>
    <label class="cursor-pointer rounded-lg bg-teal-500 hover:bg-teal-400 text-canvas font-semibold px-4 py-2 text-sm transition-colors">
      <span id="upload-label">+ Upload</span>
      <input id="media-upload" type="file" accept="image/*" class="hidden" data-testid="media-upload-input" />
    </label>
  </div>

  <p id="media-msg" class="text-sm mb-4 hidden" role="status"></p>

  {media.length === 0 ? (
    <div class="rounded-2xl border border-white/10 bg-card p-12 text-center">
      <p class="text-retro-400">No images uploaded yet.</p>
    </div>
  ) : (
    <>
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <input id="media-search" type="search" placeholder="Search images…" data-testid="media-search"
          class="flex-1 min-w-[200px] bg-elevated border border-white/10 rounded-lg px-3 py-2 text-sm text-retro-50 focus:outline-none focus:ring-2 focus:ring-teal-400/60 transition" />
        <select id="media-filter" data-testid="media-filter"
          class="bg-elevated border border-white/10 rounded-lg px-3 py-2 text-sm text-retro-50 focus:outline-none focus:ring-2 focus:ring-teal-400/60 transition">
          <option value="all">All images</option>
          <option value="used">Used</option>
          <option value="unused">Unused</option>
        </select>
        <span id="filter-count" class="text-xs text-retro-400"></span>
      </div>

      <div id="media-toolbar" class="flex items-center justify-between gap-4 mb-4">
        <label class="flex items-center gap-2 text-sm text-retro-400 cursor-pointer">
          <input type="checkbox" id="select-all" class="media-check" data-testid="media-select-all" /> Select all
        </label>
        <div id="bulk-actions" class="hidden items-center gap-3">
          <span id="bulk-count" class="text-sm text-retro-50/80"></span>
          <button id="bulk-delete" data-testid="media-bulk-delete"
            class="text-sm rounded-lg border border-red-500/30 text-red-300 px-3 py-1.5 hover:bg-red-500/10 transition-colors">Delete selected</button>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4" data-testid="media-grid">
        {items.map(({ m, usage }) => (
          <figure class="relative rounded-xl border border-white/10 bg-card overflow-hidden group" data-testid="media-item" data-media-id={m.id} data-used={usage.length} data-name={m.originalName.toLowerCase()}>
            <label class="absolute top-2 left-2 z-10 flex items-center justify-center w-7 h-7 rounded-md bg-black/50 backdrop-blur-sm cursor-pointer">
              <input type="checkbox" class="media-select media-check" data-id={m.id} data-testid="media-select" />
            </label>
            <div class="aspect-square bg-elevated overflow-hidden">
              <img src={m.url} alt={m.originalName} loading="lazy" class="w-full h-full object-cover" />
            </div>
            <figcaption class="p-3 space-y-2">
              <p class="text-xs font-mono text-retro-50/70 truncate" title={m.originalName}>{m.originalName}</p>
              <p class="text-[10px] font-mono text-retro-400">{formatDate(m.createdAt)} · {(m.size / 1024).toFixed(0)} KB</p>
              {usage.length > 0 ? (
                <p class="text-[10px] text-amber-300/80" data-testid="media-usage" title={usage.map((u) => u.title).join(", ")}>
                  Used in {usage.length} post{usage.length > 1 ? "s" : ""}
                </p>
              ) : (
                <p class="text-[10px] text-retro-400/60" data-testid="media-usage">Not used</p>
              )}
              <div class="flex gap-2">
                <button data-url={m.url} class="copy-url-btn flex-1 text-xs rounded-md border border-white/10 py-1.5 hover:border-teal-500/40 hover:text-teal-300 transition-colors" data-testid="media-copy-button">Copy URL</button>
                <label class="replace-btn cursor-pointer text-xs rounded-md border border-white/15 px-2.5 py-1.5 hover:border-teal-500/40 hover:text-teal-300 transition-colors" title="Replace file (keeps the same link)">
                  Replace
                  <input type="file" accept="image/*" class="replace-input hidden" data-id={m.id} data-testid="media-replace-input" />
                </label>
                <button data-id={m.id} class="delete-media-btn text-xs rounded-md border border-red-500/30 text-red-300 px-2.5 py-1.5 hover:bg-red-500/10 transition-colors" data-testid="media-delete-button" title="Delete image">Delete</button>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </>
  )}
</AdminLayout>

<script>
  const msg = document.getElementById("media-msg") as HTMLElement;
  function show(text: string, ok = true) {
    msg.textContent = text;
    msg.className = `text-sm mb-4 ${ok ? "text-teal-300" : "text-red-400"}`;
  }

  document.getElementById("media-upload")?.addEventListener("change", async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    const label = document.getElementById("upload-label")!;
    label.textContent = "Uploading…";
    const fd = new FormData();
    fd.append("file", file);
    try {
      const res = await fetch("/actions/upload", { method: "POST", body: fd });
      const json = await res.json();
      if (!res.ok) throw new Error(json.error || "Upload failed.");
      window.location.reload();
    } catch (err) {
      show(err instanceof Error ? err.message : "Upload failed.", false);
      label.textContent = "+ Upload";
    }
  });

  document.querySelectorAll(".copy-url-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const url = (btn as HTMLButtonElement).dataset.url!;
      const absolute = new URL(url, window.location.origin).toString();
      try {
        await navigator.clipboard.writeText(absolute);
        show("Copied image URL to clipboard ✓");
      } catch {
        show(absolute, true);
      }
    });
  });

  // ---- Selection + bulk delete ----
  const selected = new Set<string>();
  const bulkActions = document.getElementById("bulk-actions");
  const bulkCount = document.getElementById("bulk-count");
  const bulkDelete = document.getElementById("bulk-delete") as HTMLButtonElement | null;
  const selectAll = document.getElementById("select-all") as HTMLInputElement | null;

  function refreshBulk() {
    const boxes = Array.from(document.querySelectorAll<HTMLInputElement>(".media-select"));
    if (bulkActions) bulkActions.classList.toggle("hidden", selected.size === 0);
    if (bulkActions) bulkActions.classList.toggle("flex", selected.size > 0);
    if (bulkCount) bulkCount.textContent = `${selected.size} selected`;
    if (selectAll) selectAll.checked = boxes.length > 0 && selected.size === boxes.length;
  }

  document.querySelectorAll<HTMLInputElement>(".media-select").forEach((cb) => {
    cb.addEventListener("change", () => {
      const id = cb.dataset.id!;
      if (cb.checked) selected.add(id); else selected.delete(id);
      refreshBulk();
    });
  });

  selectAll?.addEventListener("change", () => {
    document.querySelectorAll<HTMLInputElement>(".media-select").forEach((cb) => {
      cb.checked = selectAll.checked;
      const id = cb.dataset.id!;
      if (selectAll.checked) selected.add(id); else selected.delete(id);
    });
    refreshBulk();
  });

  function usedCountOf(ids: string[]) {
    return ids.filter((id) => Number(document.querySelector(`[data-media-id='${id}']`)?.getAttribute("data-used") || 0) > 0).length;
  }

  bulkDelete?.addEventListener("click", async () => {
    const ids = [...selected];
    if (!ids.length) return;
    const used = usedCountOf(ids);
    let warn = `Delete ${ids.length} selected image${ids.length > 1 ? "s" : ""} permanently?`;
    if (used) warn += `\n\n${used} of them ${used > 1 ? "are" : "is"} still used in posts and will show broken images.`;
    if (!confirm(warn)) return;
    bulkDelete.textContent = "Deleting…";
    bulkDelete.disabled = true;
    let ok = 0, fail = 0;
    for (const id of ids) {
      try {
        const res = await fetch(`/actions/media/${id}`, { method: "DELETE" });
        if (res.ok) { document.querySelector(`[data-media-id='${id}']`)?.remove(); selected.delete(id); ok++; }
        else fail++;
      } catch { fail++; }
    }
    bulkDelete.textContent = "Delete selected";
    bulkDelete.disabled = false;
    show(`Deleted ${ok} image${ok !== 1 ? "s" : ""}${fail ? `, ${fail} failed` : " ✓"}`, fail === 0);
    refreshBulk();
    if (!document.querySelector("[data-testid='media-item']")) window.location.reload();
  });

  document.querySelectorAll(".delete-media-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = (btn as HTMLButtonElement).dataset.id!;
      const used = Number(btn.closest("[data-media-id]")?.getAttribute("data-used") || 0);
      let warn = "Delete this image permanently?";
      if (used) warn += `\n\nIt is still used in ${used} post${used > 1 ? "s" : ""} and will show a broken image.`;
      if (!id || !confirm(warn)) return;
      const original = btn.textContent;
      btn.textContent = "Deleting…";
      (btn as HTMLButtonElement).disabled = true;
      try {
        const res = await fetch(`/actions/media/${id}`, { method: "DELETE" });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || "Delete failed.");
        selected.delete(id);
        btn.closest("[data-testid='media-item']")?.remove();
        refreshBulk();
        applyFilter();
        show("Image deleted ✓");
        if (!document.querySelector("[data-testid='media-item']")) window.location.reload();
      } catch (err) {
        show(err instanceof Error ? err.message : "Delete failed.", false);
        btn.textContent = original;
        (btn as HTMLButtonElement).disabled = false;
      }
    });
  });

  // ---- Replace file in place (same URL → all posts update) ----
  document.querySelectorAll<HTMLInputElement>(".replace-input").forEach((inp) => {
    inp.addEventListener("change", async () => {
      const file = inp.files?.[0];
      const id = inp.dataset.id!;
      if (!file || !id) return;
      const fig = inp.closest("[data-media-id]");
      show("Replacing…");
      const fd = new FormData();
      fd.append("file", file);
      try {
        const res = await fetch(`/actions/media/${id}`, { method: "PUT", body: fd });
        const json = await res.json();
        if (!res.ok) throw new Error(json.error || "Replace failed.");
        const img = fig?.querySelector("img") as HTMLImageElement | null;
        if (img && json.asset) {
          const u = json.asset.url as string;
          img.src = u + (u.includes("?") ? "&" : "?") + "t=" + Date.now();
        }
        show("Image replaced ✓ — posts using it now show the new file");
      } catch (err) {
        show(err instanceof Error ? err.message : "Replace failed.", false);
      } finally {
        inp.value = "";
      }
    });
  });

  // ---- Search + used/unused filter ----
  const search = document.getElementById("media-search") as HTMLInputElement | null;
  const filter = document.getElementById("media-filter") as HTMLSelectElement | null;
  const filterCount = document.getElementById("filter-count");
  function applyFilter() {
    if (!search || !filter) return;
    const q = search.value.trim().toLowerCase();
    const mode = filter.value;
    let shown = 0;
    document.querySelectorAll<HTMLElement>("[data-testid='media-item']").forEach((fig) => {
      const name = fig.getAttribute("data-name") || "";
      const used = Number(fig.getAttribute("data-used") || 0) > 0;
      const matchQ = !q || name.includes(q);
      const matchMode = mode === "all" || (mode === "used" && used) || (mode === "unused" && !used);
      const visible = matchQ && matchMode;
      fig.classList.toggle("hidden", !visible);
      if (visible) shown++;
    });
    if (filterCount) filterCount.textContent = `${shown} shown`;
  }
  search?.addEventListener("input", applyFilter);
  filter?.addEventListener("change", applyFilter);
  applyFilter();
</script>

<style>
  .media-check { accent-color: #2dd4bf; width: 1rem; height: 1rem; cursor: pointer; }
</style>
