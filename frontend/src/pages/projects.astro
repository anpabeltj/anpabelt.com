---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectsExplorer from "../components/react/ProjectsExplorer.tsx";
import { listProjects } from "../lib/projects";

const records = await listProjects({ status: "published" });
const projects = records.map((p) => ({
  title: p.title,
  description: p.description,
  image: p.image ?? "/assets/images/dummy-image-project.jpg",
  tech: p.techStacks,
  githubUrl: p.githubUrl,
  liveUrl: p.liveUrl,
}));
---

<BaseLayout title="Works" description="Selected works & disciplines — web, data and everything between.">
  <section class="max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-12 pt-28 sm:pt-32 pb-6">
    <!-- Header -->
    <div class="flex justify-between items-baseline pb-6 border-b border-white/10">
      <p class="text-xs tracking-[0.2em] text-white/60 uppercase font-light font-display">// Selected Works &amp; Disciplines</p>
      <span class="italic text-xs tracking-[0.2em] text-white/40 font-light font-serif">[ 01 — {String(projects.length).padStart(2, "0")} ]</span>
    </div>

    <ProjectsExplorer client:load projects={projects} />
  </section>
</BaseLayout>