---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { listProjects } from "../lib/projects";

const records = await listProjects({ status: "published" });
const projects = records.map((p) => ({
  title: p.title,
  description: p.description,
  image: p.image ?? "/assets/images/dummy-image-project.jpg",
  tags: p.techStacks.map((name) => ({ name })),
  links: [
    ...(p.liveUrl ? [{ label: "View Live", href: p.liveUrl }] : []),
    ...(p.githubUrl ? [{ label: "GitHub", href: p.githubUrl }] : []),
  ],
}));

const allTech = Array.from(new Set(records.flatMap((r) => r.techStacks))).sort((a, b) =>
  a.localeCompare(b)
);
const chipId = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<BaseLayout title="Projects" description="A curated selection of things Anpabelt has designed, built and analysed — web, data and everything between.">
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="reveal font-mono text-xs uppercase tracking-widest text-mint/80">Work</p>
    <h1 class="reveal mt-3 font-display text-4xl sm:text-5xl font-bold" style="animation-delay:60ms">
      Curated <span class="text-retro-400">Projects</span>
    </h1>
    <p class="reveal mt-5 max-w-2xl text-retro-50/80 leading-relaxed" style="animation-delay:100ms">
      A mix of web builds, data analyses and experiments. Each one taught me something —
      usually the hard way.
    </p>

    {allTech.length > 0 && (
      <div class="reveal mt-10 flex flex-wrap items-center gap-2" data-testid="project-filters" style="animation-delay:140ms">
        <span class="mr-1 font-mono text-xs uppercase tracking-widest text-retro-50/40">Filter</span>
        <button type="button" class="project-chip chip-active" data-tech="__all__" data-testid="project-filter-all">All</button>
        {allTech.map((t) => (
          <button type="button" class="project-chip" data-tech={t.toLowerCase()} data-testid={`project-filter-${chipId(t)}`}>{t}</button>
        ))}
      </div>
    )}

    <div id="projects-grid" class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>

    <p id="projects-empty" class="hidden mt-12 text-center text-retro-400" data-testid="projects-empty">
      No projects match that filter yet.
    </p>
  </section>
</BaseLayout>

<style>
  .project-chip {
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: var(--card, rgba(255, 255, 255, 0.03));
    padding: 0.35rem 0.85rem;
    font-size: 0.85rem;
    color: rgba(231, 246, 238, 0.7);
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
    cursor: pointer;
  }
  .project-chip:hover {
    color: #fff;
    border-color: rgba(94, 234, 212, 0.35);
  }
  .project-chip.chip-active {
    background: rgba(45, 212, 191, 0.15);
    color: #5eead4;
    border-color: rgba(45, 212, 191, 0.45);
  }
</style>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".project-chip"));
  const allChip = chips.find((c) => c.getAttribute("data-tech") === "__all__") || null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="project-card"]'));
  const empty = document.getElementById("projects-empty");
  const selected = new Set<string>();

  function render() {
    let shown = 0;
    cards.forEach((c) => {
      const techs = (c.getAttribute("data-tech") || "").split("|").filter(Boolean);
      // AND semantics: a card must contain EVERY selected tech to stay visible.
      const visible = selected.size === 0 || [...selected].every((t) => techs.includes(t));
      c.classList.toggle("hidden", !visible);
      if (visible) shown++;
    });
    if (empty) empty.classList.toggle("hidden", shown > 0);
    if (allChip) allChip.classList.toggle("chip-active", selected.size === 0);
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const token = chip.getAttribute("data-tech") || "";
      if (token === "__all__") {
        selected.clear();
        chips.forEach((x) => x.classList.remove("chip-active"));
      } else {
        if (selected.has(token)) { selected.delete(token); chip.classList.remove("chip-active"); }
        else { selected.add(token); chip.classList.add("chip-active"); }
      }
      render();
    });
  });

  render();
</script>
