---
import BaseLayout from "../layouts/BaseLayout.astro";
import { experiences, education, techStack, site } from "../lib/site";
---

<BaseLayout title="About" description="Anpabelt Trah Javala — developer, data enthusiast and design tinkerer. Experience, education and the tech I love.">
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="reveal font-mono text-xs uppercase tracking-widest text-mint/80">About</p>
    <h1 class="reveal mt-3 font-display text-4xl sm:text-5xl font-bold" style="animation-delay:60ms">
      About <span class="text-retro-400">Me</span>
    </h1>

    <div class="reveal mt-12 flex flex-col sm:flex-row items-center sm:items-start gap-8 sm:gap-12" style="animation-delay:100ms">
      <div class="profile-wrap shrink-0">
        <img src="/assets/images/profile-image-3.png" alt="Anpabelt Trah Javala" class="profile-img w-32 h-32 sm:w-44 sm:h-44 rounded-full object-cover border border-white/10" />
      </div>
      <div class="io-reveal text-center sm:text-left">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-white">Anpabelt Trah Javala</h2>
        <p class="mt-4 text-retro-50/80 leading-relaxed max-w-xl">
          Hi, I'm Anpabelt — you can call me <span class="name-accent">Ann</span>. I'm a full-time
          student at Universiti Teknologi Petronas (UTP), Malaysia, with a passion for blending
          creativity and technology. My journey revolves around web development, data science and design.
        </p>
      </div>
    </div>

    <!-- What I do — animated skill cards -->
    <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-5">
      {[
        {
          n: "01",
          title: "Web Development",
          body: "I build intuitive websites that (mostly) don't break — from portfolios to complex projects.",
          icon: `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>`,
        },
        {
          n: "02",
          title: "Data Science",
          body: "I dive into datasets with Python, turning raw numbers into stories and visualisations.",
          icon: `<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>`,
        },
        {
          n: "03",
          title: "Design",
          body: "I explore modern aesthetics, balancing function and creativity to craft designs that feel right.",
          icon: `<path d="m12 19 7-7 3 3-7 7-3-3z"/><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/>`,
        },
      ].map((s, i) => (
        <article
          class="skill-card io-reveal group relative rounded-2xl border border-white/5 bg-card/50 backdrop-blur-sm p-6 transition-all duration-500 hover:-translate-y-1.5 hover:border-mint/40 hover:shadow-[0_28px_55px_-28px_rgba(0,0,0,0.75)]"
          style={`transition-delay:${i * 110}ms`}
          data-testid={`skill-card-${i}`}
        >
          <div class="flex items-center justify-between">
            <div class="w-12 h-12 rounded-xl grid place-items-center bg-mint/10 text-mint transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
            </div>
            <span class="font-mono text-xs text-retro-400 group-hover:text-mint transition-colors">{s.n}</span>
          </div>
          <h3 class="mt-5 font-display text-lg font-semibold text-white">{s.title}</h3>
          <p class="mt-2 text-sm text-retro-50/70 leading-relaxed">{s.body}</p>
          <span class="skill-glow" aria-hidden="true"></span>
        </article>
      ))}
    </div>

    <!-- Tech marquee -->
    <div class="mt-14">
      <p class="text-center sm:text-left text-retro-50/80">I enjoy diving into these tech stacks ✨</p>
      <div class="mt-6 w-full overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_80px,black_calc(100%-80px),transparent)]">
        <ul class="flex items-center gap-10 w-max animate-[marquee_28s_linear_infinite]">
          {[...techStack, ...techStack].map((icon) => (
            <li class="shrink-0"><img src={`/assets/icons/${icon}.svg`} alt="" class="w-9 h-9 sm:w-11 sm:h-11 opacity-90" loading="lazy" /></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Experience -->
    <h2 class="mt-20 font-display text-2xl sm:text-3xl font-semibold">Work Experience</h2>
    <div class="mt-8 space-y-6">
      {experiences.map((exp) => (
        <article class="reveal rounded-2xl border border-white/5 bg-card p-6 sm:p-7 transition-all duration-300 hover:border-mint/25">
          <div class="flex items-start gap-4">
            <img src={exp.logo} alt={exp.org} class="w-12 h-12 rounded-lg object-cover shrink-0" />
            <div class="flex-1 min-w-0">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <h3 class="font-display text-lg font-semibold text-white">{exp.role}</h3>
                <p class="text-xs font-mono text-mint/80 shrink-0">{exp.period}</p>
              </div>
              <p class="text-sm text-retro-400">{exp.org}</p>
              <p class="text-sm text-retro-400">{exp.location}</p>
              <ul class="mt-4 space-y-2 list-disc pl-5 text-sm text-retro-50/80 leading-relaxed">
                {exp.bullets.map((b) => <li>{b}</li>)}
              </ul>
              {exp.tags && (
                <ul class="mt-4 flex flex-wrap gap-1.5">
                  {exp.tags.map((t) => (
                    <li class="inline-flex items-center gap-1.5 rounded-full bg-elevated border border-white/5 px-2.5 py-1 text-xs font-mono text-retro-50/80">
                      <img src={`/assets/icons/${t}.svg`} alt="" class="w-3.5 h-3.5" /> {t}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Education -->
    <h2 class="mt-16 font-display text-2xl sm:text-3xl font-semibold">Education</h2>
    <div class="mt-8 space-y-6">
      {education.map((ed) => (
        <article class="reveal rounded-2xl border border-white/5 bg-card p-6 sm:p-7 transition-all duration-300 hover:border-mint/25">
          <div class="flex items-start gap-4">
            <img src={ed.logo} alt={ed.school} class="w-12 h-12 rounded-lg object-cover shrink-0" />
            <div class="flex-1">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <h3 class="font-display text-lg font-semibold text-white">{ed.school}</h3>
                <p class="text-xs font-mono text-mint/80 shrink-0">{ed.period}</p>
              </div>
              <p class="text-sm text-retro-400">{ed.degree}</p>
              <p class="text-sm text-retro-400">{ed.location}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 flex justify-center">
      <a href={site.resumeUrl} target="_blank" rel="noopener noreferrer" data-testid="about-resume-link" class="inline-flex items-center gap-3 rounded-full border border-white/15 hover:border-mint/50 hover:text-mint px-6 py-3 transition-colors">
        See Full Résumé →
      </a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .animate-\[marquee_28s_linear_infinite\] { animation: none; } }
</style>
