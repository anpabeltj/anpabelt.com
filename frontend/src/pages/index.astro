---
declare const Astro: any;
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects, loves } from "../lib/site";
import { listPosts } from "../lib/posts";
import { formatDate, readingTime } from "../lib/markdown";

const featured = projects.slice(0, 2);
const latestPosts = (await listPosts({ status: "published" })).slice(0, 3);
const n2 = (i: number) => String(i + 1).padStart(2, "0");
---

<BaseLayout>
  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-16 pb-16">
    <p class="reveal font-mono text-xs uppercase tracking-[0.25em] text-retro-400">Personal site · Malaysia</p>

    <h1 class="reveal mt-7 font-display font-semibold text-5xl sm:text-7xl leading-[1.02]" style="animation-delay:80ms">
      Hi there.<br />
      I'm <em class="italic text-mint">Anpabelt</em><span class="text-mint">.</span>
    </h1>
    <p class="reveal mt-4 font-mono text-sm text-retro-400" style="animation-delay:120ms">
      (An-Pa-Belt — like a belt, but cooler.)
    </p>

    <p class="reveal mt-8 max-w-2xl text-lg sm:text-xl text-retro-50/75 leading-relaxed" style="animation-delay:160ms">
      I'm a student at Universiti Teknologi Petronas, Malaysia, working somewhere between web
      development, data, and design. This is my corner of the internet — a place for my work,
      my writing, and the things I'm still figuring out.
    </p>

    <div class="reveal mt-10 flex flex-wrap items-center gap-6" style="animation-delay:200ms">
      <a href="/about" data-testid="hero-about" class="rounded-full bg-mint hover:bg-mint-bright text-canvas font-medium px-6 py-3 transition-colors">
        More about me
      </a>
      <a href="/projects" data-testid="hero-work" class="text-retro-50/80 hover:text-mint transition-colors">
        See my work <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- Three things -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="rule"></div>
    <h2 class="mt-12 font-display text-3xl sm:text-4xl font-semibold max-w-md leading-tight">
      Three things I keep coming back to
    </h2>
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8">
      {loves.map((item, i) => (
        <div class="reveal" style={`animation-delay:${i * 90}ms`}>
          <p class="font-mono text-sm text-mint">{n2(i)}</p>
          <h3 class="mt-3 font-display text-xl font-semibold text-white">{item.title}</h3>
          <p class="mt-3 text-retro-50/70 leading-relaxed">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Selected work -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="rule"></div>
    <div class="mt-12 flex items-end justify-between gap-4">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold">Selected work</h2>
      <a href="/projects" data-testid="home-all-projects-link" class="text-sm text-retro-50/70 hover:text-mint transition-colors shrink-0">All projects →</a>
    </div>

    <div class="mt-14 space-y-20">
      {featured.map((p, i) => (
        <article class="reveal grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 items-center" style={`animation-delay:${i * 90}ms`} data-testid="project-card">
          <div class="md:col-span-6">
            <p class="font-mono text-sm text-mint">{n2(i)}</p>
            <h3 class="mt-3 font-display text-2xl font-semibold text-white">{p.title}</h3>
            <p class="mt-4 text-retro-50/70 leading-relaxed">{p.description}</p>
            <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-retro-400">
              {p.tags.map((tag) => (
                <li class="inline-flex items-center gap-1.5">
                  {tag.icon && <img src={tag.icon} alt="" class="w-4 h-4 opacity-80" width="16" height="16" />}
                  <span>{tag.name}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 flex flex-wrap gap-6">
              {p.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer" data-testid="project-link"
                  class="text-sm text-white hover:text-mint transition-colors border-b border-white/20 hover:border-mint pb-0.5">
                  {link.label} →
                </a>
              ))}
            </div>
          </div>
          <div class="md:col-span-6">
            <div class="overflow-hidden rounded-xl border border-white/10 aspect-[16/11] bg-elevated">
              <img src={p.image} alt={p.title} loading="lazy" class="w-full h-full object-cover transition-transform duration-700 hover:scale-[1.03]" />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- From the journal -->
  {latestPosts.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="rule"></div>
      <div class="mt-12 flex items-end justify-between gap-4">
        <h2 class="font-display text-3xl sm:text-4xl font-semibold">From the journal</h2>
        <a href="/blog" data-testid="home-all-posts-link" class="text-sm text-retro-50/70 hover:text-mint transition-colors shrink-0">All writing →</a>
      </div>
      <ul class="mt-10 divide-y divide-white/10 border-t border-white/10">
        {latestPosts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}`} data-testid="journal-post-link" class="group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 py-5 hover:pl-2 transition-all duration-300">
              <span class="font-mono text-xs text-retro-400 shrink-0 sm:w-48">
                {formatDate(post.publishedAt ?? post.createdAt)} · {readingTime(post.content)} min
              </span>
              <span class="font-display text-lg text-white group-hover:text-mint transition-colors">{post.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
