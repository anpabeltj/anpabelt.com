---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" noindex={true}>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 py-24 text-center">
    <p class="font-display text-7xl font-bold text-teal-400">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold">Lost in space</h1>
    <p class="mt-4 text-retro-50/80">This page drifted off somewhere among the stars.</p>
    <a href="/" data-testid="notfound-home-link" class="mt-8 inline-flex rounded-full bg-teal-500 hover:bg-teal-400 text-canvas font-semibold px-6 py-3 transition-colors">
      Take me home
    </a>
  </section>
</BaseLayout>
