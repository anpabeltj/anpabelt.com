---
declare const Astro: any;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Gallery from "../../components/Gallery.astro";
import { getPostBySlug, listPosts } from "../../lib/posts";
import { renderContent, readingTime, formatDate } from "../../lib/markdown";

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;

// Only published posts are public. Drafts are 404 here (preview lives in /admin).
if (!post || post.status !== "published") {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const isGallery = post.type === "gallery" || post.type === "photo";
const html = post.content.trim() ? renderContent(post.content) : "";
const minutes = readingTime(post.content);

const published = await listPosts({ status: "published" });
const idx = published.findIndex((p) => p.id === post.id);
const prev = idx >= 0 && idx < published.length - 1 ? published[idx + 1] : null;
const next = idx > 0 ? published[idx - 1] : null;
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  image={post.coverImage ?? undefined}
  type="article"
  publishedTime={post.publishedAt ?? undefined}
  tags={post.tags}
>
  <div class="reading-progress" id="reading-progress"></div>

  <article class="max-w-[820px] mx-auto px-6 sm:px-10 pt-28 sm:pt-32">
    <a href="/blog" data-testid="article-back-link" class="inline-flex items-center gap-2 font-mono text-[9px] uppercase tracking-[0.16em] text-white/50 hover:text-white transition-colors">
      ← Back to journal
    </a>

    <header class="mt-10 pb-6 border-b border-white/10">
      <div class="flex flex-wrap items-center gap-3 italic text-xs tracking-[0.2em] text-white/40 font-light font-serif">
        <time datetime={post.publishedAt ?? post.createdAt}>{formatDate(post.publishedAt ?? post.createdAt)}</time>
        <span class="text-white/20 not-italic">/</span>
        {isGallery ? <span class="not-italic font-sans text-[8.5px] uppercase tracking-[0.16em]">{post.images.length} photos</span> : <span class="not-italic font-sans text-[8.5px] uppercase tracking-[0.16em]">{minutes} min read</span>}
      </div>
      <h1 class="mt-5 font-display text-3xl sm:text-4xl text-white/95 leading-[1.15] tracking-[0.02em] font-normal">{post.title}</h1>
      {post.tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1.5">
          {post.tags.map((t) => (
            <li><a href={`/blog?tag=${encodeURIComponent(t)}`} class="font-mono text-[8.5px] uppercase tracking-[0.16em] text-white/40 hover:text-white transition-colors">#{t}</a></li>
          ))}
        </ul>
      )}
    </header>

    {post.coverImage && (
      <img src={post.coverImage} alt={post.title} data-zoomable="true" data-gallery="article" data-caption={post.title} class="mt-8 w-full border border-white/10 aspect-[16/9] object-cover cursor-zoom-in" />
    )}

    {isGallery ? (
      <>
        {html && <div class="article-content mt-10" data-testid="article-content" set:html={html}></div>}
        <Gallery images={post.images} />
      </>
    ) : (
      <div class="article-content mt-10" data-testid="article-content" set:html={html}></div>
    )}

    <nav class="mt-16 grid grid-cols-1 sm:grid-cols-2 gap-px bg-white/10 border border-white/10">
      {prev && (
        <a href={`/blog/${prev.slug}`} class={`group bg-black p-5 hover:bg-white/[0.03] transition-colors ${next ? "" : "sm:col-span-2"}`} data-testid="article-prev-link">
          <span class="font-mono text-[8.5px] uppercase tracking-[0.16em] italic font-serif normal-case">← Previous</span>
          <p class="mt-2 font-display text-base text-white/90 group-hover:text-white transition-colors leading-snug">{prev.title}</p>
        </a>
      )}
      {next && (
        <a href={`/blog/${next.slug}`} class="group bg-black p-5 hover:bg-white/[0.03] transition-colors sm:text-right" data-testid="article-next-link">
          <span class="font-mono text-[8.5px] uppercase tracking-[0.16em] italic font-serif normal-case">Next →</span>
          <p class="mt-2 font-display text-base text-white/90 group-hover:text-white transition-colors leading-snug">{next.title}</p>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>

<script>
  const bar = document.getElementById("reading-progress");
  const update = () => {
    const h = document.documentElement;
    const scrolled = h.scrollTop / (h.scrollHeight - h.clientHeight);
    if (bar) bar.style.width = `${Math.min(100, Math.max(0, scrolled * 100))}%`;
  };
  document.addEventListener("scroll", update, { passive: true });
  update();
</script>
