---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { listPosts } from "../../lib/posts";

declare const Astro: any;
const posts = await listPosts({ status: "published" });

const activeTag = Astro.url.searchParams.get("tag");
const filtered = activeTag ? posts.filter((p) => p.tags.includes(activeTag)) : posts;
const allTags = [...new Set(posts.flatMap((p) => p.tags))].sort();
---

<BaseLayout title="Journal" description="Personal writing by Anpabelt — notes on building for the web, working with data, student life and whatever else is on my mind." type="website">
  <section class="max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-12 pt-28 sm:pt-32 pb-6">
    <!-- Header -->
    <div class="flex justify-between items-baseline pb-6 border-b border-white/10">
      <p class="text-xs tracking-[0.2em] text-white/60 uppercase font-light font-display">// Journal &amp; Field Notes</p>
      <span class="italic text-xs tracking-[0.2em] text-white/40 font-light font-serif">[ {String(posts.length).padStart(2, "0")} ENTRIES ]</span>
    </div>

    {allTags.length > 0 && (
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 border-b border-white/10 pb-6" data-testid="blog-tag-filters">
        <span class="font-mono text-[8.5px] uppercase tracking-[0.18em] text-white/40 mr-1">Topics:</span>
        <a href="/blog" class={`text-xs lowercase tracking-[0.18em] font-display transition-colors ${!activeTag ? "text-white" : "text-white/40 hover:text-white"}`}>
          all
        </a>
        {allTags.map((t) => (
          <a href={`/blog?tag=${encodeURIComponent(t)}`} class={`text-xs lowercase tracking-[0.18em] font-display transition-colors ${activeTag === t ? "text-white" : "text-white/40 hover:text-white"}`}>
            {t}
          </a>
        ))}
      </div>
    )}

    <div class="mt-6 space-y-0" data-testid="blog-post-list">
      {filtered.length === 0 ? (
        <p class="text-white/40 py-20 text-center font-mono text-sm">No entries yet. Come back soon.</p>
      ) : (
        filtered.map((post, i) => <PostCard post={post} index={i} />)
      )}
    </div>
  </section>
</BaseLayout>