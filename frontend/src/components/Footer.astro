---
import { socials } from "../lib/site";
const year = new Date().getFullYear();
---

<footer class="relative mt-16 border-t border-white/10">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-12 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center space-x-5 text-xs text-white/60 font-light">
      <span class="lowercase font-normal tracking-[0.25em] text-white/90 font-display">anpabelt</span>
      <span class="hidden md:inline text-white/20">·</span>
      <span class="hidden md:inline text-[9px] font-sans tracking-[0.16em] text-white/40 uppercase">Nurture Editorial Direction</span>
      <span class="hidden md:inline text-white/20">·</span>
      <span class="text-[9px] font-sans tracking-[0.16em] text-white/40 uppercase">© {year}</span>
    </div>
    <ul class="flex items-center space-x-6 text-xs tracking-[0.2em] lowercase font-light text-white/70 font-display" data-testid="footer-socials">
      {socials.map((s) => (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            data-testid={`footer-social-${s.label.toLowerCase()}`}
            class="hover:text-white transition-colors duration-200"
          >
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
