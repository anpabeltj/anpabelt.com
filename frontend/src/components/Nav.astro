---
declare const Astro: any;
import { navLinks } from "../lib/site";
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50 transition-colors duration-300">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-end gap-4">
    <nav class="hidden md:block" data-testid="main-nav">
      <ul class="flex items-center gap-8 text-sm">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-testid={`nav-${link.label.toLowerCase()}-link`}
              class={`transition-colors duration-300 ${isActive(link.href) ? "text-mint" : "text-retro-50/70 hover:text-white"}`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      id="nav-toggle"
      class="md:hidden text-white p-1"
      aria-label="Toggle menu"
      aria-expanded="false"
      data-testid="nav-mobile-toggle"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div id="nav-mobile-menu" class="hidden md:hidden border-t border-white/10 bg-canvas/95 backdrop-blur-xl">
    <ul class="max-w-5xl mx-auto px-4 sm:px-6 py-3 flex flex-col gap-1 text-base">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            data-testid={`nav-mobile-${link.label.toLowerCase()}-link`}
            class={`block py-2.5 transition-colors ${isActive(link.href) ? "text-mint" : "text-retro-50/80 hover:text-white"}`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!open));
  });

  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    const scrolled = window.scrollY > 12;
    header.classList.toggle("bg-canvas/80", scrolled);
    header.classList.toggle("backdrop-blur-xl", scrolled);
    header.classList.toggle("border-b", scrolled);
    header.classList.toggle("border-white/5", scrolled);
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
