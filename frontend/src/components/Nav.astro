---
import { navLinks } from "../lib/site";
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="fixed top-4 sm:top-6 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-1.5rem)] sm:w-auto max-w-3xl">
  <nav
    class="backdrop-blur-xl bg-[hsl(144,14%,7%)]/80 border border-white/10 rounded-2xl sm:rounded-full px-4 sm:px-6 py-2.5 shadow-2xl"
    data-testid="main-nav"
  >
    <div class="flex items-center justify-between gap-4">
      <a href="/" class="font-display font-bold text-sm tracking-tight text-white shrink-0" data-testid="nav-brand">
        ann<span class="text-teal-400">.</span>
      </a>

      <ul class="hidden md:flex items-center gap-7 font-medium text-sm">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-testid={`nav-${link.label.toLowerCase()}-link`}
              class={`transition-colors duration-300 ${isActive(link.href) ? "text-teal-400" : "text-retro-50/80 hover:text-teal-400"}`}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href="/admin"
            data-testid="nav-admin-link"
            class="text-xs font-mono border border-teal-500/40 text-teal-300 hover:bg-teal-500/10 rounded-full px-3 py-1.5 transition-colors"
          >
            Admin
          </a>
        </li>
      </ul>

      <!-- Mobile toggle -->
      <button
        id="nav-toggle"
        class="md:hidden text-white p-1"
        aria-label="Toggle menu"
        aria-expanded="false"
        data-testid="nav-mobile-toggle"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <ul id="nav-mobile-menu" class="hidden md:hidden flex-col gap-1 pt-3 mt-2 border-t border-white/10 font-medium">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            data-testid={`nav-mobile-${link.label.toLowerCase()}-link`}
            class={`block py-2 px-2 rounded-lg transition-colors ${isActive(link.href) ? "text-teal-400" : "text-retro-50/80 hover:text-teal-400"}`}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href="/admin" data-testid="nav-mobile-admin-link" class="block py-2 px-2 rounded-lg text-teal-300 font-mono text-sm">Admin</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!open));
  });
</script>
