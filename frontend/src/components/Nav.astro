---
declare const Astro: any;
import { navLinks } from "../lib/site";
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50 transition-colors duration-300">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-end gap-4">
    <nav class="hidden md:block" data-testid="main-nav">
      <ul class="flex items-center gap-8 text-sm">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-testid={`nav-${link.label.toLowerCase()}-link`}
              class={`transition-colors duration-300 ${isActive(link.href) ? "text-mint" : "text-retro-50/70 hover:text-white"}`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      data-command-open
      data-testid="nav-search-button"
      aria-label="Open quick search"
      class="hidden md:inline-flex items-center gap-2 rounded-full border border-white/10 bg-card/60 px-3 py-1.5 text-xs text-retro-50/60 hover:text-white hover:border-mint/30 transition-colors"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3" stroke-linecap="round"/></svg>
      Search
      <kbd class="font-mono border border-white/10 rounded px-1 py-0.5 text-[10px]">⌘K</kbd>
    </button>

    <button
      type="button"
      data-command-open
      data-testid="nav-search-button-mobile"
      aria-label="Open quick search"
      class="md:hidden text-white/80 hover:text-white"
    >
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3" stroke-linecap="round"/></svg>
    </button>

    <button
      id="nav-toggle"
      class="ham md:hidden relative w-7 h-7 text-white"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-mobile-menu"
      data-testid="nav-mobile-toggle"
    >
      <span class="ham-bar ham-top"></span>
      <span class="ham-bar ham-mid"></span>
      <span class="ham-bar ham-bot"></span>
    </button>
  </div>

  <div
    id="nav-mobile-menu"
    class="mobile-menu md:hidden border-t border-white/10 bg-canvas/95 backdrop-blur-xl"
    data-testid="nav-mobile-menu"
  >
    <ul class="max-w-5xl mx-auto px-4 sm:px-6 py-3 flex flex-col gap-1 text-base">
      {navLinks.map((link, i) => (
        <li class="menu-item" style={`--i:${i}`}>
          <a
            href={link.href}
            data-testid={`nav-mobile-${link.label.toLowerCase()}-link`}
            class={`block py-2.5 transition-colors ${isActive(link.href) ? "text-mint" : "text-retro-50/80 hover:text-white"}`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  /* Animated hamburger -> X */
  .ham-bar {
    position: absolute;
    left: 3px;
    right: 3px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease, top 0.3s ease;
  }
  .ham-top { top: 8px; }
  .ham-mid { top: 13px; }
  .ham-bot { top: 18px; }
  .ham[aria-expanded="true"] .ham-top { top: 13px; transform: rotate(45deg); }
  .ham[aria-expanded="true"] .ham-mid { opacity: 0; transform: scaleX(0.4); }
  .ham[aria-expanded="true"] .ham-bot { top: 13px; transform: rotate(-45deg); }

  /* Smooth slide/fade menu */
  .mobile-menu {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
  }
  .mobile-menu.open {
    max-height: 22rem;
    opacity: 1;
  }

  /* Staggered item reveal when the menu opens */
  .menu-item {
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 45ms);
  }
  .mobile-menu.open .menu-item {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .ham-bar, .mobile-menu, .menu-item { transition: none; }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-mobile-menu");

  const setOpen = (open: boolean) => {
    toggle?.setAttribute("aria-expanded", String(open));
    menu?.classList.toggle("open", open);
  };

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  // close after tapping a link
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setOpen(false))
  );

  // close if resized up to desktop
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768) setOpen(false);
  });

  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    const scrolled = window.scrollY > 12;
    header.classList.toggle("bg-canvas/80", scrolled);
    header.classList.toggle("backdrop-blur-xl", scrolled);
    header.classList.toggle("border-b", scrolled);
    header.classList.toggle("border-white/5", scrolled);
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  document.querySelectorAll("[data-command-open]").forEach((btn) =>
    btn.addEventListener("click", () => window.dispatchEvent(new CustomEvent("open-command-palette")))
  );
</script>
