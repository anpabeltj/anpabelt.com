---
declare const Astro: any;
import type { ProjectRecord } from "../lib/types";
export interface Props {
  project?: ProjectRecord | null;
}
const { project = null } = Astro.props;
const initial = {
  id: project?.id ?? null,
  title: project?.title ?? "",
  description: project?.description ?? "",
  image: project?.image ?? "",
  techStacks: project?.techStacks ?? [],
  githubUrl: project?.githubUrl ?? "",
  liveUrl: project?.liveUrl ?? "",
  status: project?.status ?? "draft",
};
---

<form id="project-editor" class="grid grid-cols-1 lg:grid-cols-3 gap-6" data-testid="project-editor">
  <!-- Main column -->
  <div class="lg:col-span-2 space-y-5">
    <div>
      <input id="p-title" type="text" placeholder="Project title" value={initial.title} data-testid="project-title-input"
        class="w-full bg-transparent font-display text-2xl sm:text-3xl font-bold text-white placeholder:text-retro-400 focus:outline-none border-b border-white/10 focus:border-teal-500/50 pb-3 transition-colors" />
    </div>

    <div>
      <label for="p-description" class="block text-sm font-medium mb-2">Description</label>
      <textarea id="p-description" rows="8" placeholder="Tell the story of this project…" data-testid="project-description-input"
        class="w-full bg-elevated border border-white/10 rounded-xl px-4 py-4 min-h-[280px] text-sm text-retro-50 leading-relaxed focus:outline-none focus:ring-2 focus:ring-teal-400/50 transition resize-y">{initial.description}</textarea>
    </div>
  </div>

  <!-- Sidebar -->
  <aside class="space-y-5">
    <div class="rounded-2xl border border-white/10 bg-card p-5 space-y-4">
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium">Status</span>
        <span id="p-status-badge" class={`text-xs font-mono px-2 py-1 rounded-full ${initial.status === "published" ? "bg-emerald-500/15 text-emerald-300" : "bg-amber-500/15 text-amber-300"}`} data-testid="project-status-badge">{initial.status}</span>
      </div>

      <div class="flex flex-col gap-2">
        <button type="button" id="p-save-draft" data-testid="project-save-draft-button"
          class="w-full rounded-lg border border-white/15 py-2.5 text-sm font-medium hover:border-white/30 transition-colors">Save draft</button>
        <button type="button" id="p-publish" data-testid="project-publish-button"
          class="w-full rounded-lg bg-teal-500 hover:bg-teal-400 text-canvas py-2.5 text-sm font-semibold transition-colors">Publish</button>
        <button type="button" id="p-unpublish" data-testid="project-unpublish-button"
          class={`w-full rounded-lg border border-amber-500/30 text-amber-300 py-2.5 text-sm font-medium hover:bg-amber-500/10 transition-colors ${initial.status === "published" ? "" : "hidden"}`}>Unpublish</button>
      </div>
      <p id="p-status-msg" class="text-xs text-center hidden" role="status"></p>
    </div>

    <div class="rounded-2xl border border-white/10 bg-card p-5 space-y-3">
      <label class="text-sm font-medium">Project image</label>
      <div id="p-cover-dropzone" data-testid="project-cover-dropzone" class="space-y-3">
        <div id="p-cover-wrap" class={`overflow-hidden rounded-lg border border-white/10 aspect-[16/10] bg-elevated ${initial.image ? "" : "hidden"}`}>
          <img id="p-cover-preview" src={initial.image} alt="Project preview" class="w-full h-full object-cover" />
        </div>
        <div class="flex items-center gap-2">
          <label class="flex-1 cursor-pointer text-center rounded-lg border border-white/15 py-2 text-sm hover:border-teal-500/40 transition-colors">
            <span id="p-upload-label">Upload</span>
            <input id="p-cover-file" type="file" accept="image/*" class="hidden" data-testid="project-cover-upload" />
          </label>
          <button type="button" id="p-clear-cover" class={`rounded-lg border border-white/15 px-3 py-2 text-sm hover:text-red-300 transition-colors ${initial.image ? "" : "hidden"}`}>Clear</button>
        </div>
        <p class="text-[11px] text-center text-retro-50/40">or drop an image here</p>
      </div>
      <input id="p-cover-url" type="text" placeholder="or paste image URL / path" value={initial.image} data-testid="project-cover-url"
        class="w-full bg-elevated border border-white/10 rounded-md px-3 py-2 text-xs font-mono text-retro-50 focus:outline-none focus:ring-2 focus:ring-teal-400/60 transition" />
    </div>

    <div class="rounded-2xl border border-white/10 bg-card p-5 space-y-3">
      <label for="p-tech" class="text-sm font-medium">Tech stacks</label>
      <input id="p-tech" type="text" placeholder="e.g. Python, SQL, React" value={initial.techStacks.join(", ")} data-testid="project-tech-input"
        class="w-full bg-elevated border border-white/10 rounded-md px-3 py-2 text-sm font-mono text-retro-50 focus:outline-none focus:ring-2 focus:ring-teal-400/60 transition" />
      <p class="text-[11px] text-retro-50/40">Separate each with a comma.</p>

      <label for="p-github" class="text-sm font-medium">GitHub link <span class="text-retro-400 font-normal">(optional)</span></label>
      <input id="p-github" type="url" placeholder="https://github.com/you/project" value={initial.githubUrl} data-testid="project-github-input"
        class="w-full bg-elevated border border-white/10 rounded-md px-3 py-2 text-sm font-mono text-retro-50 focus:outline-none focus:ring-2 focus:ring-teal-400/60 transition" />

      <label for="p-live" class="text-sm font-medium">Live preview <span class="text-retro-400 font-normal">(optional)</span></label>
      <input id="p-live" type="url" placeholder="https://your-project.com" value={initial.liveUrl} data-testid="project-live-input"
        class="w-full bg-elevated border border-white/10 rounded-md px-3 py-2 text-sm font-mono text-retro-50 focus:outline-none focus:ring-2 focus:ring-teal-400/60 transition" />
    </div>

    <button type="button" id="p-delete" data-testid="project-delete-button"
      class={`w-full rounded-lg border border-red-500/30 text-red-300 py-2.5 text-sm font-medium hover:bg-red-500/10 transition-colors ${initial.id ? "" : "hidden"}`}>Delete project</button>
  </aside>
</form>

<script type="application/json" id="project-data" is:inline set:html={JSON.stringify(initial).replace(/</g, "\\u003c")}></script>
<script>
  type ProjInit = {
    id: string | null; title: string; description: string; image: string;
    techStacks: string[]; githubUrl: string; liveUrl: string; status: "draft" | "published";
  };
  const initial: ProjInit = JSON.parse(document.getElementById("project-data")!.textContent || "{}");
  let projectId = initial.id;

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const titleEl = $("p-title") as HTMLInputElement;
  const descEl = $("p-description") as HTMLTextAreaElement;
  const techEl = $("p-tech") as HTMLInputElement;
  const githubEl = $("p-github") as HTMLInputElement;
  const liveEl = $("p-live") as HTMLInputElement;
  const coverUrlEl = $("p-cover-url") as HTMLInputElement;
  const coverPreview = $("p-cover-preview") as HTMLImageElement;
  const coverWrap = $("p-cover-wrap");
  const clearCoverBtn = $("p-clear-cover");
  const statusBadge = $("p-status-badge");
  const unpublishBtn = $("p-unpublish");
  const msg = $("p-status-msg");

  function setCover(url: string) {
    coverUrlEl.value = url;
    if (url) {
      coverPreview.src = url;
      coverWrap.classList.remove("hidden");
      clearCoverBtn.classList.remove("hidden");
    } else {
      coverWrap.classList.add("hidden");
      clearCoverBtn.classList.add("hidden");
    }
  }

  function show(text: string, ok = true) {
    msg.textContent = text;
    msg.className = `text-xs text-center ${ok ? "text-teal-300" : "text-red-400"}`;
  }

  coverUrlEl.addEventListener("input", () => setCover(coverUrlEl.value.trim()));
  clearCoverBtn.addEventListener("click", () => setCover(""));

  async function uploadFile(file: File) {
    const label = $("p-upload-label");
    label.textContent = "Uploading…";
    const fd = new FormData();
    fd.append("file", file);
    try {
      const res = await fetch("/actions/upload", { method: "POST", body: fd });
      const j = await res.json();
      if (!res.ok) throw new Error(j.error || "Upload failed.");
      setCover(j.asset.url);
    } catch (err) {
      show(err instanceof Error ? err.message : "Upload failed.", false);
    } finally {
      label.textContent = "Upload";
    }
  }

  ($("p-cover-file") as HTMLInputElement).addEventListener("change", (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (f) uploadFile(f);
  });

  const dz = $("p-cover-dropzone");
  ["dragover", "dragenter"].forEach((ev) => dz.addEventListener(ev, (e) => { e.preventDefault(); dz.classList.add("ring-2", "ring-teal-400/50"); }));
  ["dragleave", "drop"].forEach((ev) => dz.addEventListener(ev, (e) => { e.preventDefault(); dz.classList.remove("ring-2", "ring-teal-400/50"); }));
  dz.addEventListener("drop", (e: Event) => {
    const f = (e as DragEvent).dataTransfer?.files?.[0];
    if (f) uploadFile(f);
  });

  function collect(status: "draft" | "published") {
    return {
      title: titleEl.value.trim(),
      description: descEl.value,
      image: coverUrlEl.value.trim(),
      techStacks: techEl.value,
      githubUrl: githubEl.value.trim(),
      liveUrl: liveEl.value.trim(),
      status,
    };
  }

  async function save(status: "draft" | "published") {
    const payload = collect(status);
    if (!payload.title) { show("Title is required.", false); titleEl.focus(); return; }
    show("Saving…");
    try {
      const url = projectId ? `/actions/projects/${projectId}` : "/actions/projects";
      const method = projectId ? "PUT" : "POST";
      const res = await fetch(url, {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const j = await res.json();
      if (!res.ok) throw new Error(j.error || "Save failed.");
      const saved = j.project;
      if (!projectId) {
        projectId = saved.id;
        window.location.href = `/admin/projects/${saved.id}/edit`;
        return;
      }
      statusBadge.textContent = saved.status;
      statusBadge.className = `text-xs font-mono px-2 py-1 rounded-full ${saved.status === "published" ? "bg-emerald-500/15 text-emerald-300" : "bg-amber-500/15 text-amber-300"}`;
      unpublishBtn.classList.toggle("hidden", saved.status !== "published");
      show(saved.status === "published" ? "Published ✓" : "Draft saved ✓");
    } catch (err) {
      show(err instanceof Error ? err.message : "Save failed.", false);
    }
  }

  $("p-save-draft").addEventListener("click", () => save("draft"));
  $("p-publish").addEventListener("click", () => save("published"));
  unpublishBtn.addEventListener("click", () => save("draft"));

  $("p-delete").addEventListener("click", async () => {
    if (!projectId || !confirm(`Delete "${titleEl.value || "this project"}"? This cannot be undone.`)) return;
    const res = await fetch(`/actions/projects/${projectId}`, { method: "DELETE" });
    if (res.ok) window.location.href = "/admin/projects";
    else show("Failed to delete project.", false);
  });
</script>
