---
declare const Astro: any;
import type { Post } from "../lib/types";
import { formatDate, readingTime } from "../lib/markdown";
export interface Props {
  post: Post;
  index?: number;
}
const { post, index = 0 } = Astro.props;
const isGallery = post.type === "gallery" || post.type === "photo";
const minutes = readingTime(post.content);
const cover = post.coverImage || (isGallery ? post.images[0]?.url ?? null : null);
---

<article
  class="reveal group grid grid-cols-1 md:grid-cols-12 gap-6 border-b border-white/10 pb-10"
  style={`animation-delay:${index * 70}ms`}
  data-testid="post-card"
>
  {cover && (
    <a href={`/blog/${post.slug}`} class="md:col-span-4 block overflow-hidden rounded-xl aspect-[16/10] bg-elevated relative" data-testid="post-card-cover-link">
      <img src={cover} alt={post.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
      {isGallery && (
        <span class="absolute top-2 right-2 rounded-full bg-black/60 backdrop-blur px-2 py-0.5 text-[10px] font-mono text-white">🖼 {post.images.length}</span>
      )}
    </a>
  )}
  <div class={cover ? "md:col-span-8" : "md:col-span-12"}>
    <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-mint/80">
      <time datetime={post.publishedAt ?? post.createdAt}>{formatDate(post.publishedAt ?? post.createdAt)}</time>
      <span class="text-retro-400">•</span>
      {isGallery ? <span>{post.images.length} photos</span> : <span>{minutes} min read</span>}
    </div>
    <h2 class="mt-2 font-display text-xl sm:text-2xl font-semibold leading-tight">
      <a href={`/blog/${post.slug}`} class="text-white hover:text-mint transition-colors" data-testid="post-card-title-link">
        {post.title}
      </a>
    </h2>
    <p class="mt-3 text-retro-50/70 leading-relaxed">{post.excerpt}</p>
    {post.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {post.tags.map((t) => (
          <li class="rounded-full border border-white/5 bg-elevated px-2.5 py-0.5 text-xs font-mono text-retro-50/70">#{t}</li>
        ))}
      </ul>
    )}
  </div>
</article>
