---
// Site-wide backdrop: "ARCHIVE 2025" architectural crosshair system —
// corner crop marks, dashed guide frame, hairline axes with travelling laser
// pulses, a rotating astrolabe emblem, micro telemetry labels and a
// cursor-following ambient glow. Fully visible at the top of the page and
// fading to barely visible once the user scrolls, so content stays the focus.
// DOM elements replay their CSS entrance animations on every full navigation,
// so no cache-busting is needed (no ViewTransitions in this project).
//
// The telemetry marker label (SEC 01 // REF.0x) follows the current page.

const pageRefs = {
  "/": "REF.00",
  "/projects": "REF.01",
  "/about": "REF.02",
  "/blog": "REF.03",
  "/contact": "REF.04",
};
const pathname = Astro.url.pathname;
const pageRef = pageRefs[pathname] ?? "REF.--";
---

<div class="backdrop" aria-hidden="true">
  <div class="bg-scene" id="bg-scene">
    <!-- Architectural registration / crop marks -->
    <div class="crop crop-tl"><span class="mark-v"></span><span class="mark-h"></span></div>
    <div class="crop crop-tr"><span class="mark-v"></span><span class="mark-h"></span></div>
    <div class="crop crop-bl"><span class="mark-v"></span><span class="mark-h"></span></div>
    <div class="crop crop-br"><span class="mark-v"></span><span class="mark-h"></span></div>

    <!-- Dashed guide frame bracketing the crosshair -->
    <div class="frame-line fl-h1"></div>
    <div class="frame-line fl-h2"></div>
    <div class="frame-line fl-v1"></div>
    <div class="frame-line fl-v2"></div>

    <!-- Micro telemetry labels -->
    <div class="b-label lbl-sec"><span class="plus">+</span>SEC 01 // {pageRef}</div>
    <div class="b-label lbl-cal"><span class="rule"></span>CAL.35&deg;</div>
    <div class="b-label lbl-deg">[ 00&deg; ]<span class="rule"></span></div>
    <div class="plus-mark pm-1">+</div>
    <div class="plus-mark pm-2">+</div>

    <!-- Crosshair axes with travelling laser pulses -->
    <div class="axis axis-h"><div class="pulse pulse-h"></div></div>
    <div class="axis axis-v"><div class="pulse pulse-v"></div></div>

    <!-- Astrolabe emblem sitting on the horizontal hairline -->
    <div class="astrolabe" id="bg-astrolabe">
      <div class="tg-outer">
        <div class="tg-ring-dashed"></div>
        <div class="tg-ring-partial"></div>
        <div class="tg-ticks">
          <span class="tick tick-n"></span>
          <span class="tick tick-s"></span>
          <span class="tick tick-e"></span>
          <span class="tick tick-w"></span>
        </div>
        <div class="tg-ring-inner"></div>
        <div class="tg-medallion">
          <svg viewBox="0 0 32 32" fill="none" stroke="#000" stroke-width="1.3">
            <circle cx="16" cy="16" r="12" stroke-dasharray="2 2"></circle>
            <circle cx="16" cy="16" r="6"></circle>
            <circle cx="16" cy="16" r="2" fill="#000"></circle>
            <path d="M16 2v7M16 23v7M2 16h7M23 16h7"></path>
            <path d="M6.5 6.5l4.5 4.5M21 21l4.5 4.5M25.5 6.5L21 11M11 21l-4.5 4.5" stroke-width="0.8"></path>
          </svg>
        </div>
        <div class="tg-ping"></div>
        <div class="tg-node"></div>
      </div>
    </div>

    <!-- Cursor-following ambient glow -->
    <div class="ambient-glow" id="bg-glow"></div>
  </div>
</div>

<script>
  (function () {
    const scene = document.getElementById("bg-scene");
    if (!scene) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ---- scroll-linked opacity: visible at the top, barely visible scrolled ----
    const TOP_O = 1;    // full ARCHIVE_2025 stage at scrollY = 0
    const DIM_O = 0.04; // barely visible while reading content
    const RAMP_PX = 240;
    let ticking = false;

    function apply() {
      ticking = false;
      const y = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;
      const t = y <= 0 ? 0 : Math.min(1, y / RAMP_PX);
      scene.style.opacity = (TOP_O + (DIM_O - TOP_O) * t).toFixed(3);
    }
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    apply();

    if (reduce) return;

    // ---- ambient cursor glow + gentle astrolabe parallax ----
    // Always initialized: on touch/coarse devices no pointer events fire, so
    // the glow simply stays at its idle 0.35 — harmless. Fine pointers get
    // the full follow + fade-on-idle behavior. (The (pointer: fine) media
    // query is NOT used as a gate: headless browsers and some WebViews report
    // pointer:none and would dead-code this block entirely.)
    const glow = document.getElementById("bg-glow");

    const astro = document.getElementById("bg-astrolabe");
    let mx = window.innerWidth / 2;
    let my = window.innerHeight / 2;
    let cx = mx, cy = my;
    let idle;

    function frame() {
      cx += (mx - cx) * 0.07;
      cy += (my - cy) * 0.07;
      glow.style.transform =
        "translate(" + cx.toFixed(1) + "px, " + cy.toFixed(1) + "px) translate(-50%, -50%)";
      if (astro) {
        const nx = (cx / window.innerWidth - 0.5) * 2;
        const ny = (cy / window.innerHeight - 0.5) * 2;
        // Desktop: anchor is left:68% — translateY(-100%) sits it above the
        // hairline. Mobile: anchor is right-edge bleed — same transform keeps
        // it half-visible at the top of the axis. Parallax is a gentle nudge.
        astro.style.transform =
          "translate(" + (nx * 12).toFixed(2) + "px, " + (ny * 7).toFixed(2) + "px) translateY(-100%)";
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);

    window.addEventListener("mousemove", function (e) {
      mx = e.clientX;
      my = e.clientY;
      glow.style.opacity = "1";
      clearTimeout(idle);
      idle = setTimeout(function () { glow.style.opacity = "0.35"; }, 2500);
    }, { passive: true });
    window.addEventListener("mouseleave", function () { glow.style.opacity = "0"; }, { passive: true });
  })();
</script>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;
    pointer-events: none;
    background-color: #000;
  }

  .bg-scene {
    --axis-y: 260px; /* horizontal hairline; sits just below the fixed header */
    position: absolute;
    inset: 0;
    opacity: 1; /* no-JS default; JS links it to scroll position */
  }

  /* ---------- crop marks ---------- */
  .crop { position: absolute; width: 32px; height: 32px; }
  .crop span { position: absolute; background: #fff; }
  .crop .mark-v { width: 2px; height: 32px; }
  .crop .mark-h { width: 32px; height: 2px; }
  .crop-tl { top: 104px; left: 24px; opacity: 0.85; }
  .crop-tl .mark-v { left: 0; top: 0; }
  .crop-tl .mark-h { left: 0; top: 0; }
  .crop-tr { top: 104px; right: 24px; opacity: 0.85; }
  .crop-tr .mark-v { right: 0; top: 0; }
  .crop-tr .mark-h { right: 0; top: 0; }
  .crop-bl { bottom: 24px; left: 24px; opacity: 0.5; }
  .crop-bl .mark-v { left: 0; bottom: 0; }
  .crop-bl .mark-h { left: 0; bottom: 0; }
  .crop-br { bottom: 24px; right: 24px; opacity: 0.5; }
  .crop-br .mark-v { right: 0; bottom: 0; }
  .crop-br .mark-h { right: 0; bottom: 0; }

  /* ---------- dashed guide frame ---------- */
  .frame-line { position: absolute; }
  .fl-h1 { left: 0; right: 0; top: calc(var(--axis-y) - 24px); border-bottom: 1px dashed rgba(255, 255, 255, 0.10); }
  .fl-h2 { left: 0; right: 0; top: calc(var(--axis-y) + 24px); border-bottom: 1px dashed rgba(255, 255, 255, 0.07); }
  .fl-v1 { top: 0; bottom: 0; left: calc(68% - 24px); border-right: 1px dashed rgba(255, 255, 255, 0.08); }
  .fl-v2 { top: 0; bottom: 0; left: calc(68% + 24px); border-right: 1px dashed rgba(255, 255, 255, 0.05); }
  @media (min-width: 1024px) {
    .fl-h1 { border-bottom-color: rgba(255, 255, 255, 0.15); }
    .fl-h2 { border-bottom-color: rgba(255, 255, 255, 0.10); }
    .fl-v1 { border-right-color: rgba(255, 255, 255, 0.15); }
    .fl-v2 { border-right-color: rgba(255, 255, 255, 0.10); }
  }

  /* ---------- micro telemetry labels ---------- */
  .b-label {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: "JetBrains Mono", monospace;
    font-size: 8px;
    letter-spacing: 0.25em;
    color: #888;
    opacity: 0.4;
    white-space: nowrap;
  }
  .b-label .plus { color: rgba(255, 255, 255, 0.7); }
  .b-label .rule { width: 16px; height: 1px; background: rgba(255, 255, 255, 0.4); }
  .lbl-sec { top: calc(var(--axis-y) - 44px); left: 48px; }
  .lbl-cal { bottom: 64px; left: 25%; }
  .lbl-deg { right: 32px; top: var(--axis-y); transform: translateY(-50%); }
  @media (max-width: 639px) {
    .lbl-cal, .lbl-deg { display: none; }
  }
  .plus-mark {
    position: absolute;
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    color: rgba(255, 255, 255, 0.3);
  }
  .pm-1 { top: 33%; left: 33%; }
  .pm-2 { bottom: 24%; right: 25%; }

  /* ---------- crosshair axes ---------- */
  .axis { position: absolute; pointer-events: none; }
  .axis-h {
    left: 0;
    right: 0;
    top: var(--axis-y);
    height: 1px;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.75) 25%,
      rgba(255, 255, 255, 0.95) 45%,
      rgba(255, 255, 255, 0.6) 80%,
      rgba(255, 255, 255, 0.05) 100%
    );
    transform-origin: 44% center;
    --axis-final: 1;
    animation: expandH 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @media (max-width: 1023px) { .axis-h { --axis-final: 0.5; } }
  .axis-v {
    top: -100px;
    bottom: -100px;
    left: 68%;
    width: 1px;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.05) 0%,
      rgba(255, 255, 255, 0.85) 30%,
      rgba(255, 255, 255, 0.95) 48%,
      rgba(255, 255, 255, 0.5) 85%,
      rgba(255, 255, 255, 0.05) 100%
    );
    transform-origin: center 148px;
    --axis-final: 1;
    animation: expandV 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  @media (max-width: 639px) { .axis-v { --axis-final: 0.12; } }
  @media (min-width: 640px) and (max-width: 1023px) { .axis-v { --axis-final: 0.25; } }

  /* travelling laser pulses along the hairlines */
  .pulse { position: absolute; pointer-events: none; }
  .pulse-h {
    top: -1px;
    left: -140px;
    width: 140px;
    height: 3px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.95), transparent);
    filter: blur(0.5px);
    animation: scanBeamH 7s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  .pulse-v {
    left: -1px;
    top: -140px;
    width: 3px;
    height: 140px;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.95), transparent);
    filter: blur(0.5px);
    animation: scanBeamV 8.5s cubic-bezier(0.4, 0, 0.2, 1) 1.2s infinite;
  }

  @keyframes scanBeamH {
    0% { left: -140px; opacity: 0; }
    15% { opacity: 0.9; }
    85% { opacity: 0.9; }
    100% { left: 100%; opacity: 0; }
  }
  @keyframes scanBeamV {
    0% { top: -140px; opacity: 0; }
    15% { opacity: 0.9; }
    85% { opacity: 0.9; }
    100% { top: 100%; opacity: 0; }
  }
  @keyframes expandH {
    0% { transform: scaleX(0); opacity: 0; }
    100% { transform: scaleX(1); opacity: var(--axis-final, 1); }
  }
  @keyframes expandV {
    0% { transform: scaleY(0); opacity: 0; }
    100% { transform: scaleY(1); opacity: var(--axis-final, 1); }
  }

  /* ---------- astrolabe emblem ---------- */
  .astrolabe {
    --tg: 96px;
    position: absolute;
    top: var(--axis-y);
    transform: translateY(-100%);
    /* Mobile-first default: bleed off the right edge, half-visible,
       mirroring the crop-mark language — no content collision. */
    right: -48px;
    left: auto;
  }
  @media (min-width: 640px) { .astrolabe { --tg: 120px; right: -24px; } }
  @media (min-width: 1024px) {
    .astrolabe { --tg: 145px; right: auto; left: calc(68% + 36px); }
  }

  .tg-outer {
    position: relative;
    width: var(--tg);
    height: var(--tg);
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.75);
    box-shadow: 0 0 25px rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: orbitRotate 45s linear infinite;
  }
  .tg-ring-dashed {
    position: absolute;
    inset: -16px;
    border: 1px dashed rgba(255, 255, 255, 0.2);
    border-radius: 50%;
  }
  .tg-ring-partial {
    position: absolute;
    inset: -32px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    opacity: 0.4;
    clip-path: polygon(0 0, 60% 0, 60% 60%, 0 60%);
  }
  .tg-ticks {
    position: absolute;
    inset: 0;
    animation: orbitRotate 90s linear infinite;
  }
  .tg-ticks .tick { position: absolute; width: 1px; height: 6px; background: rgba(255, 255, 255, 0.4); }
  .tg-ticks .tick-n { left: 50%; top: 0; transform: translateX(-50%); }
  .tg-ticks .tick-s { left: 50%; bottom: 0; transform: translateX(-50%); }
  .tg-ticks .tick-e { top: 50%; right: 0; width: 6px; height: 1px; transform: translateY(-50%); }
  .tg-ticks .tick-w { top: 50%; left: 0; width: 6px; height: 1px; transform: translateY(-50%); }
  .tg-ring-inner {
    position: absolute;
    inset: 16px;
    border: 1px dashed rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    animation: counterRotate 30s linear infinite;
  }
  .tg-medallion {
    position: relative;
    z-index: 2;
    width: 38px;
    height: 38px;
    background: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.92;
  }
  .tg-medallion svg { width: 22px; height: 22px; }
  @media (min-width: 640px) {
    .tg-medallion { width: 46px; height: 46px; }
    .tg-medallion svg { width: 28px; height: 28px; }
  }
  @media (min-width: 768px) {
    .tg-medallion { width: 56px; height: 56px; }
    .tg-medallion svg { width: 32px; height: 32px; }
  }
  .tg-node {
    position: absolute;
    top: -2px;
    left: 50%;
    transform: translate(-50%, 0);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    animation: nodePulse 3.2s ease-in-out infinite;
  }
  .tg-ping {
    position: absolute;
    top: -2px;
    left: 50%;
    transform: translate(-50%, 0);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.8);
    animation: pingGlow 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes orbitRotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes counterRotate { from { transform: rotate(0deg); } to { transform: rotate(-360deg); } }
  @keyframes nodePulse {
    0%, 100% { transform: translate(-50%, 0) scale(1); box-shadow: 0 0 4px rgba(255, 255, 255, 0.6); }
    50% { transform: translate(-50%, 0) scale(1.6); box-shadow: 0 0 12px rgba(255, 255, 255, 0.95); }
  }
  @keyframes pingGlow {
    0% { transform: translate(-50%, 0) scale(1); opacity: 0.9; }
    100% { transform: translate(-50%, 0) scale(3.5); opacity: 0; }
  }

  /* ---------- ambient glow ---------- */
  .ambient-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.035) 0%, rgba(255, 255, 255, 0) 70%);
    pointer-events: none;
    transform: translate(-50%, -50%);
    opacity: 0.35;
    transition: opacity 0.6s ease;
    z-index: 1;
  }
  @media (pointer: coarse) { .ambient-glow { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    .axis-h, .axis-v, .pulse-h, .pulse-v, .tg-outer, .tg-ring-inner, .tg-ticks,
    .tg-node, .tg-ping, .ambient-glow {
      animation: none !important;
    }
    .axis-h { transform: scaleX(1); opacity: 1; }
    .axis-v { transform: scaleY(1); opacity: 1; }
    .pulse-h, .pulse-v, .ambient-glow { opacity: 0 !important; }
    .tg-outer, .tg-ring-inner, .tg-ticks { transform: none !important; }
    .tg-node, .tg-ping { transform: translate(-50%, 0) !important; }
  }
</style>