---
declare const Astro: any;
import type { Post } from "../lib/types";
import { toEditableHtml } from "../lib/markdown";
export interface Props {
  post?: Post | null;
}
const { post = null } = Astro.props;
const initial = {
  id: post?.id ?? null,
  title: post?.title ?? "",
  slug: post?.slug ?? "",
  excerpt: post?.excerpt ?? "",
  content: post?.content ?? "",
  coverImage: post?.coverImage ?? "",
  status: post?.status ?? "draft",
  type: post?.type ?? "article",
  images: post?.images ?? [],
  tags: post?.tags ?? [],
};
const isGallery = initial.type === "gallery" || initial.type === "photo";
// Seed the editable area with sanitized HTML (legacy Markdown is auto-converted).
const initialHtml = initial.content.trim() ? toEditableHtml(initial.content) : "";
---

<form id="post-editor" class="grid grid-cols-1 lg:grid-cols-3 gap-6" data-testid="post-editor">
  <!-- Main column -->
  <div class="lg:col-span-2 space-y-5">
    <!-- Post type selector -->
    <div class="inline-flex rounded-lg border border-white/10 bg-elevated p-1 text-sm" data-testid="editor-type-selector">
      <button type="button" data-type="article" data-testid="editor-type-article"
        class={`type-btn px-4 py-1.5 rounded-md transition-colors ${!isGallery ? "bg-teal-500/20 text-teal-200" : "text-retro-50/70 hover:text-white"}`}>Article</button>
      <button type="button" data-type="gallery" data-testid="editor-type-gallery"
        class={`type-btn px-4 py-1.5 rounded-md transition-colors ${isGallery ? "bg-teal-500/20 text-teal-200" : "text-retro-50/70 hover:text-white"}`}>Gallery</button>
    </div>

    <div>
      <input id="f-title" type="text" placeholder="Post title" value={initial.title} data-testid="editor-title-input"
        class="w-full bg-transparent font-display text-2xl sm:text-3xl font-bold text-white placeholder:text-retro-400 focus:outline-none border-b border-white/10 focus:border-teal-500/50 pb-3 transition-colors" />
    </div>

    <div class="flex items-center gap-2 text-sm">
      <span class="font-mono text-retro-400">/blog/</span>
      <input id="f-slug" type="text" placeholder="auto-generated" value={initial.slug} data-testid="editor-slug-input"
        class="flex-1 bg-elevated border border-white/10 rounded-md px-3 py-1.5 font-mono text-teal-300 focus:outline-none focus:ring-2 focus:ring-teal-400/60 transition" />
    </div>

    <div>
      <label id="content-label" class="block text-sm font-medium mb-2">{isGallery ? "Intro text (optional)" : "Content"}</label>

      <!-- Rich text toolbar (Medium style) -->
      <div id="rte-toolbar" class="rte-toolbar flex flex-wrap items-center gap-1 rounded-t-xl border border-white/10 border-b-0 bg-elevated px-2 py-1.5" data-testid="editor-toolbar">
        <select id="rte-block" title="Text style" data-testid="editor-block-select"
          class="rte-select bg-card border border-white/10 rounded-md px-2 py-1 text-xs text-retro-50 focus:outline-none focus:ring-1 focus:ring-teal-400/60">
          <option value="p">Paragraph</option>
          <option value="h1">Heading 1</option>
          <option value="h2">Heading 2</option>
          <option value="h3">Heading 3</option>
          <option value="blockquote">Quote</option>
          <option value="pre">Code block</option>
        </select>

        <select id="rte-size" title="Font size" data-testid="editor-size-select"
          class="rte-select bg-card border border-white/10 rounded-md px-2 py-1 text-xs text-retro-50 focus:outline-none focus:ring-1 focus:ring-teal-400/60">
          <option value="">Size</option>
          <option value="0.85em">Small</option>
          <option value="1em">Normal</option>
          <option value="1.35em">Large</option>
          <option value="1.75em">Huge</option>
        </select>

        <span class="rte-sep"></span>

        <button type="button" class="rte-btn font-bold" data-cmd="bold" title="Bold (Ctrl+B)" data-testid="editor-bold-button">B</button>
        <button type="button" class="rte-btn italic" data-cmd="italic" title="Italic (Ctrl+I)" data-testid="editor-italic-button">I</button>
        <button type="button" class="rte-btn underline" data-cmd="underline" title="Underline (Ctrl+U)" data-testid="editor-underline-button">U</button>
        <button type="button" class="rte-btn line-through" data-cmd="strikeThrough" title="Strikethrough" data-testid="editor-strike-button">S</button>
        <button type="button" class="rte-btn font-mono text-[13px]" data-cmd="inlineCode" title="Inline code" data-testid="editor-code-button">&lt;/&gt;</button>

        <span class="rte-sep"></span>

        <button type="button" class="rte-btn rte-color" data-color="text" title="Text color" data-testid="editor-text-color">
          <span class="rte-color-glyph">A</span>
          <span class="rte-color-bar" data-color-bar style="background:#6fe39a"></span>
        </button>
        <button type="button" class="rte-btn rte-color" data-color="highlight" title="Highlight" data-testid="editor-highlight-color">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l-6 6v3h3l6-6"/><path d="M14 6l4 4"/><path d="M20.5 8.5a2.12 2.12 0 0 0 0-3l-1-1a2.12 2.12 0 0 0-3 0L9 11l4 4 7.5-6.5z"/></svg>
          <span class="rte-color-bar" data-color-bar style="background:#f6c453"></span>
        </button>

        <span class="rte-sep"></span>

        <button type="button" class="rte-btn" data-cmd="insertUnorderedList" title="Bullet list" data-testid="editor-ul-button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="3.5" cy="6" r="1.2" fill="currentColor" stroke="none"/><circle cx="3.5" cy="12" r="1.2" fill="currentColor" stroke="none"/><circle cx="3.5" cy="18" r="1.2" fill="currentColor" stroke="none"/></svg>
        </button>
        <button type="button" class="rte-btn" data-cmd="insertOrderedList" title="Numbered list" data-testid="editor-ol-button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" y1="6" x2="21" y2="6"/><line x1="10" y1="12" x2="21" y2="12"/><line x1="10" y1="18" x2="21" y2="18"/><text x="2" y="8" font-size="7" fill="currentColor" stroke="none">1</text><text x="2" y="14" font-size="7" fill="currentColor" stroke="none">2</text><text x="2" y="20" font-size="7" fill="currentColor" stroke="none">3</text></svg>
        </button>

        <span class="rte-sep"></span>

        <button type="button" class="rte-btn" data-cmd="createLink" title="Add link" data-testid="editor-link-button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        </button>
        <button type="button" class="rte-btn" data-cmd="unlink" title="Remove link" data-testid="editor-unlink-button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.84 12.25l1.72-1.71a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M5.17 11.75l-1.71 1.71a5 5 0 0 0 7.07 7.07l1.71-1.71"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
        </button>

        <span class="rte-sep"></span>

        <label class="rte-btn cursor-pointer" title="Insert image at cursor" data-testid="editor-insert-image">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          <input id="f-inline-image" type="file" accept="image/*" class="hidden" />
        </label>
        <button type="button" id="btn-unsplash" class="rte-btn" title="Search Unsplash photos" data-testid="editor-unsplash-button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>

        <button type="button" id="btn-help" class="rte-btn ml-auto" title="Keyboard shortcuts (?)" data-testid="editor-help-button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </button>
      </div>

      <div id="f-content" contenteditable="true" role="textbox" aria-multiline="true" data-testid="editor-content-input"
        data-placeholder="Tell your story…"
        class="rte-editor article-content w-full bg-elevated border border-white/10 rounded-b-xl px-4 py-4 min-h-[420px] focus:outline-none focus:ring-2 focus:ring-teal-400/50 transition overflow-y-auto" set:html={initialHtml}></div>
      <input id="f-card-image" type="file" accept="image/*" class="hidden" />
      <div class="mt-2 flex items-center justify-between gap-3 text-xs text-retro-400">
        <p>Type <span class="font-mono text-teal-300">/</span> for blocks · drag the handle to reorder · paste a link for a card</p>
        <p id="rte-wordcount" class="font-mono whitespace-nowrap" data-testid="editor-word-count">0 words · 1 min read</p>
      </div>
    </div>

    <!-- Gallery manager -->
    <div id="gallery-manager" class={`rounded-xl border border-white/10 bg-card p-5 space-y-4 ${isGallery ? "" : "hidden"}`} data-testid="editor-gallery-manager">
      <div class="flex items-center justify-between">
        <h3 class="text-sm font-medium">Photos <span id="gallery-count" class="text-retro-400 font-mono">({initial.images.length})</span></h3>
        <div class="flex items-center gap-2">
          <button type="button" id="btn-caption-all" data-testid="gallery-caption-all"
            class="rounded-lg border border-white/15 px-3 py-1.5 text-sm hover:border-teal-500/40 hover:text-teal-300 transition-colors">Caption all</button>
          <label class="cursor-pointer rounded-lg bg-teal-500 hover:bg-teal-400 text-canvas font-semibold px-3 py-1.5 text-sm transition-colors">
            <span id="gallery-upload-label">+ Add photos</span>
            <input id="f-gallery-files" type="file" accept="image/*" multiple class="hidden" data-testid="editor-gallery-upload" />
          </label>
        </div>
      </div>
      <p id="gallery-empty" class={`text-sm text-retro-400 text-center py-6 ${initial.images.length ? "hidden" : ""}`}>No photos yet — add some to build your gallery.</p>
      <div id="gallery-list" class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
    </div>
  </div>

  <!-- Sidebar -->
  <aside class="space-y-5">
    <div class="rounded-2xl border border-white/10 bg-card p-5 space-y-4">
      <div class="flex items-center justify-between">
        <span class="text-sm font-medium">Status</span>
        <span id="status-badge" class={`text-xs font-mono px-2 py-1 rounded-full ${initial.status === "published" ? "bg-emerald-500/15 text-emerald-300" : "bg-amber-500/15 text-amber-300"}`} data-testid="editor-status-badge">{initial.status}</span>
      </div>

      <div class="flex flex-col gap-2">
        <button type="button" id="btn-save-draft" data-testid="editor-save-draft-button"
          class="w-full rounded-lg border border-white/15 py-2.5 text-sm font-medium hover:border-white/30 transition-colors">Save draft</button>
        <button type="button" id="btn-publish" data-testid="editor-publish-button"
          class="w-full rounded-lg bg-teal-500 hover:bg-teal-400 text-canvas py-2.5 text-sm font-semibold transition-colors">Publish</button>
        <button type="button" id="btn-unpublish" data-testid="editor-unpublish-button"
          class={`w-full rounded-lg border border-amber-500/30 text-amber-300 py-2.5 text-sm font-medium hover:bg-amber-500/10 transition-colors ${initial.status === "published" ? "" : "hidden"}`}>Unpublish</button>
        <button type="button" id="btn-preview" data-testid="editor-preview-button"
          class="w-full rounded-lg border border-white/15 py-2.5 text-sm font-medium hover:border-teal-500/40 hover:text-teal-300 transition-colors">Preview</button>
      </div>
      <p id="editor-status-msg" class="text-xs text-center hidden" role="status"></p>
    </div>

    <div class="rounded-2xl border border-white/10 bg-card p-5 space-y-3">
      <label class="text-sm font-medium">Cover image</label>
      <div id="cover-dropzone" data-testid="cover-dropzone" class="cover-dropzone space-y-3">
        <div id="cover-preview-wrap" class={`overflow-hidden rounded-lg border border-white/10 aspect-[16/9] bg-elevated ${initial.coverImage ? "" : "hidden"}`}>
          <img id="cover-preview" src={initial.coverImage} alt="Cover preview" class="w-full h-full object-cover" />
        </div>
        <div class="flex items-center gap-2">
          <label class="flex-1 cursor-pointer text-center rounded-lg border border-white/15 py-2 text-sm hover:border-teal-500/40 transition-colors">
            <span id="upload-label">Upload</span>
            <input id="f-cover-file" type="file" accept="image/*" multiple class="hidden" data-testid="editor-cover-upload" />
          </label>
          <button type="button" id="btn-clear-cover" class={`rounded-lg border border-white/15 px-3 py-2 text-sm hover:text-red-300 transition-colors ${initial.coverImage ? "" : "hidden"}`}>Clear</button>
        </div>
        <p class="text-[11px] text-center text-retro-50/40">or drop image(s) here — the first becomes the cover</p>
      </div>
      <input id="f-cover-url" type="text" placeholder="or paste image URL / path" value={initial.coverImage} data-testid="editor-cover-url"
        class="w-full bg-elevated border border-white/10 rounded-md px-3 py-2 text-xs font-mono text-retro-50 focus:outline-none focus:ring-2 focus:ring-teal-400/60 transition" />
    </div>

    <div class="rounded-2xl border border-white/10 bg-card p-5 space-y-3">
      <label for="f-excerpt" class="text-sm font-medium">Excerpt</label>
      <textarea id="f-excerpt" rows="3" placeholder="Short summary shown on the blog index" data-testid="editor-excerpt-input"
        class="w-full bg-elevated border border-white/10 rounded-md px-3 py-2 text-sm text-retro-50 focus:outline-none focus:ring-2 focus:ring-teal-400/60 transition resize-y">{initial.excerpt}</textarea>
      <label for="f-tags" class="text-sm font-medium">Tags</label>
      <input id="f-tags" type="text" placeholder="comma, separated, tags" value={initial.tags.join(", ")} data-testid="editor-tags-input"
        class="w-full bg-elevated border border-white/10 rounded-md px-3 py-2 text-sm font-mono text-retro-50 focus:outline-none focus:ring-2 focus:ring-teal-400/60 transition" />
    </div>

    <button type="button" id="btn-delete" data-testid="editor-delete-button"
      class={`w-full rounded-lg border border-red-500/30 text-red-300 py-2.5 text-sm font-medium hover:bg-red-500/10 transition-colors ${initial.id ? "" : "hidden"}`}>Delete post</button>
  </aside>
</form>

<!-- Unsplash search modal -->
<div id="unsplash-modal" class="unsplash-modal hidden" data-testid="unsplash-modal">
  <div class="unsplash-backdrop" data-unsplash-close></div>
  <div class="unsplash-panel" role="dialog" aria-label="Search Unsplash photos">
    <div class="unsplash-head">
      <div class="flex items-center gap-2 flex-1">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-teal-300"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input id="unsplash-input" type="text" placeholder="Search free high-res photos…" data-testid="unsplash-input"
          class="flex-1 bg-transparent text-white placeholder:text-retro-400 focus:outline-none text-sm" />
      </div>
      <button type="button" data-unsplash-close class="rte-btn" title="Close" data-testid="unsplash-close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
      </button>
    </div>
    <p id="unsplash-status" class="unsplash-status">Search for a photo to insert.</p>
    <div id="unsplash-results" class="unsplash-results" data-testid="unsplash-results"></div>
    <p class="unsplash-foot">Photos from <span class="text-teal-300">Unsplash</span> · free to use, credit added automatically.</p>
  </div>
</div>

<script type="application/json" id="editor-data" is:inline set:html={JSON.stringify(initial).replace(/</g, "\\u003c")}></script>
<script>
  import "../scripts/postEditor.ts";
</script>

