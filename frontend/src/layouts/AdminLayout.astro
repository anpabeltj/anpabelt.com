---
declare const Astro: any;
import "../styles/global.css";
import { site } from "../lib/site";
export interface Props {
  title?: string;
  active?: "posts" | "media" | "projects";
}
const { title = "Dashboard", active } = Astro.props;
const user = Astro.locals.user;
const linkCls = (key: string) =>
  `px-3 py-1.5 rounded-lg text-sm transition-colors ${active === key ? "bg-teal-500/15 text-teal-300" : "text-retro-50/70 hover:text-white hover:bg-white/5"}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} — Admin · {site.shortName}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Lexend+Giga:wght@600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-canvas text-retro-50">
    {user && (
      <header class="sticky top-0 z-40 border-b border-white/10 bg-canvas/90 backdrop-blur-xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-4">
          <div class="flex items-center gap-1 sm:gap-3">
            <a href="/admin" class="font-display font-bold text-sm mr-2">ann<span class="text-teal-400">.admin</span></a>
            <nav class="flex items-center gap-1">
              <a href="/admin" class={linkCls("posts")} data-testid="admin-nav-posts">Posts</a>
              <a href="/admin/projects" class={linkCls("projects")} data-testid="admin-nav-projects">Projects</a>
              <a href="/admin/media" class={linkCls("media")} data-testid="admin-nav-media">Media</a>
            </nav>
          </div>
          <div class="flex items-center gap-3">
            <a href="/" target="_blank" class="text-sm text-retro-50/70 hover:text-white hidden sm:inline">View site ↗</a>
            <button id="admin-logout" data-testid="admin-logout-button" class="text-sm rounded-lg border border-white/10 px-3 py-1.5 hover:border-red-500/40 hover:text-red-300 transition-colors">Log out</button>
          </div>
        </div>
      </header>
    )}

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <script>
      document.getElementById("admin-logout")?.addEventListener("click", async () => {
        await fetch("/actions/auth/logout", { method: "POST" });
        window.location.href = "/admin/login";
      });
    </script>
  </body>
</html>
