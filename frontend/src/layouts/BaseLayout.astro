---
declare const Astro: any;
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StormBackground from "../components/StormBackground.astro";
import CommandPalette from "../components/react/CommandPalette.tsx";
import Lightbox from "../components/react/Lightbox.tsx";
import AIAssistant from "../components/react/AIAssistant.tsx";
import { site, socials, navLinks } from "../lib/site";
import { listPosts } from "../lib/posts";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  publishedTime?: string;
  tags?: string[];
}

const {
  title,
  description = site.description,
  image = "/assets/images/bg-stars.jpg",
  type = "website",
  noindex = false,
  publishedTime,
  tags = [],
} = Astro.props;

const fullTitle = title ? `${title} — ${site.shortName}` : `${site.name} — Personal Website`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).toString();
const origin = (Astro.site ?? new URL(Astro.url.origin)).toString();

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: site.shortName,
  description: site.description,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  url: origin,
  image: ogImage,
  sameAs: socials.map((s) => s.href),
};
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: origin,
};

const publishedPosts = await listPosts({ status: "published" });
const commandItems = [
  ...navLinks.map((l) => ({ label: l.label, href: l.href, group: "Pages", hint: "Page" })),
  ...publishedPosts.map((p) => ({ label: p.title, href: `/blog/${p.slug}`, group: "Writing", hint: "Post" })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#05140f" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={fullTitle} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <!-- Structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <StormBackground />
    <Nav />
    <main class="flex-1 pt-24 sm:pt-28">
      <slot />
    </main>
    <Footer />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      document.querySelectorAll(".io-reveal").forEach((el) => io.observe(el));
    </script>
    <CommandPalette client:idle items={commandItems} />
    <Lightbox client:idle />
    <AIAssistant client:idle />
  </body>
</html>
